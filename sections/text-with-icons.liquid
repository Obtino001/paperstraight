{%- if section.blocks.size > 0 -%}
  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
    <div class="container">
      <div class="v-stack gap-8">
        
        {%- comment -%} ========== MOBILE ONLY - Simple scroll, NO carousel ========== {%- endcomment -%}
        <div class="twi-mobile-scroll" style="{% render 'surface', text_color: section.settings.text_color %}">
          {%- for block in section.blocks -%}
            <div class="twi-mobile-item" {{ block.shopify_attributes }}>
              {%- if block.settings.custom_icon != blank -%}
                <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="" class="twi-mobile-icon">
              {%- else -%}
                <div class="twi-mobile-icon-wrap" style="{% render 'surface', text_color: section.settings.icon_color %}">
                  {%- render 'icon' with block.settings.icon, width: block.settings.mobile_icon_width -%}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="twi-mobile-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="twi-mobile-content">{{ block.settings.content }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} ========== DESKTOP ONLY - Original layout ========== {%- endcomment -%}
        {%- capture section_content -%}
          {%- for block in section.blocks -%}
            <div class="text-with-icons__item {% if forloop.first %}is-selected{% endif %}" role="group" {{ block.shopify_attributes }}>
              <div class="v-stack gap-6 justify-items-center sm:justify-items-{{ section.settings.text_alignment }}">
                {%- liquid
                  assign loading_strategy = nil
                  if section.index <= 3 and forloop.position <= 3
                    assign loading_strategy = 'eager'
                  endif
                -%}

                {%- if block.settings.custom_icon != blank -%}
                  {%- capture sizes -%}{{ block.settings.icon_width }}px{%- endcapture -%}
                  {%- capture widths -%}{{ block.settings.icon_width }}, {{ block.settings.icon_width | times: 2 | at_most: block.settings.custom_icon.width }}{%- endcapture -%}
                  {%- capture style -%}--image-mobile-max-width: {{ block.settings.mobile_icon_width }}px; --image-max-width: {{ block.settings.icon_width }}px{%- endcapture -%}
                  {{- block.settings.custom_icon | image_url: width: block.settings.custom_icon.width | image_tag: loading: loading_strategy, sizes: sizes, widths: widths, class: 'constrained-image', style: style -}}
                {%- else -%}
                  <div style="{% render 'surface', text_color: section.settings.icon_color %}">
                    {%- render 'icon' with block.settings.icon, width: block.settings.icon_width -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank or block.settings.content != blank -%}
                  <div class="v-stack gap-2 text-center sm:text-{{ section.settings.text_alignment }}">
                    {%- if block.settings.title != blank -%}
                      <p class="h6">{{ block.settings.title }}</p>
                    {%- endif -%}
                    {%- if block.settings.content != blank -%}
                      <div class="prose">{{- block.settings.content -}}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endcapture -%}

        <div class="text-with-icons twi-desktop-only" role="region" style="{% render 'surface', text_color: section.settings.text_color %}">
          {{- section_content -}}
        </div>

      </div>
    </div>
  </div>
{%- endif -%}

<style>
  /* ========== MOBILE SCROLL STYLES ========== */
  #shopify-section-{{ section.id }} .twi-mobile-scroll {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    padding: 10px 15px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-scroll::-webkit-scrollbar {
    display: none;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-item {
    flex: 0 0 30vw;
    min-width: 40vw;
    scroll-snap-align: start;
    text-align: center;
    padding: 0 12px;
    border-right: 1px solid rgba(0, 0, 0, 0.12);
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-item:last-child {
    border-right: 0;
    padding-right: 15px;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-icon {
    width: 50px;
    height: 50px;
    object-fit: contain;
    margin: 0 auto 15px;
    display: block;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-icon-wrap {
    margin-bottom: 15px;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-icon-wrap svg {
    margin: 0 auto;
    display: block;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-title {
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 14px;
  }
  
  #shopify-section-{{ section.id }} .twi-mobile-content {
    font-size: 14px;
    line-height: 1.4;
    color: #1c1c1c;
  }

  /* ========== DESKTOP STYLES ========== */
  #shopify-section-{{ section.id }} .twi-desktop-only {
    display: none;
    align-items: flex-end;
  }
  
  #shopify-section-{{ section.id }} .twi-desktop-only .text-with-icons__item .constrained-image {
    width: 50px;
    object-fit: scale-down;
    height: 50px;
    margin: 0 auto;
  }
  
  #shopify-section-{{ section.id }} .twi-desktop-only .text-with-icons__item {
    flex: 1;
    text-align: center;
    padding: 0 20px;
    position: relative;
  }
  
  #shopify-section-{{ section.id }} .twi-desktop-only .text-with-icons__item::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 60px;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.12);
  }
  
  #shopify-section-{{ section.id }} .twi-desktop-only .text-with-icons__item:last-child::after {
    display: none;
  }

  #shopify-section-{{ section.id }} .text-with-icons__item .prose {
    font-size: 14px;
    /* font-weight: 600; */
    line-height: 100%;
  }

  .text-with-icons {
    gap: 0;
    justify-content: left;
 }

  /* ========== RESPONSIVE ========== */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .twi-mobile-scroll {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .twi-desktop-only {
      display: flex !important;
      align-items: flex-end;
    }
  }
  
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .twi-desktop-only {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .twi-mobile-scroll {
      display: flex !important;
    }
    #shopify-section-{{ section.id }} .twi-mobile-content {
      font-size: 12px;
      line-height: 1.4;
    }
  }
</style>

