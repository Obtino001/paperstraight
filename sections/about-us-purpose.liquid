{{ 'about-us-purpose.css' | asset_url | stylesheet_tag }}

<section class="about-purpose-section container section-{{ section.id }}">
  <div class="about-purpose-container">
    <!-- Left Content -->
    <div class="about-purpose-content">
      {% if section.settings.subtitle != blank %}
        <span class="about-purpose-subtitle">{{ section.settings.subtitle }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="about-purpose-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="about-purpose-text-blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'paragraph' %}
              <p class="about-purpose-paragraph">{{ block.settings.text }}</p>
            
            {% when 'subheading' %}
              <h3 class="about-purpose-subheading">{{ block.settings.subheading_text }}</h3>
            
            {% when 'button' %}
              <a href="{{ block.settings.button_link }}" class="about-purpose-button" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ block.settings.button_text }}
              </a>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <!-- Right Image -->
    <div class="about-purpose-image-wrapper">
      {% if section.settings.image != blank %}
        <img 
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                  {{ section.settings.image | image_url: width: 600 }} 600w,
                  {{ section.settings.image | image_url: width: 800 }} 800w,
                  {{ section.settings.image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="{{ section.settings.image_alt | default: section.settings.heading }}"
          class="about-purpose-image"
          loading="lazy"
        >
      {% else %}
        <div class="about-purpose-placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --about-bg-color: {{ section.settings.background_color }};
    --about-text-color: {{ section.settings.text_color }};
    --about-heading-color: {{ section.settings.heading_color }};
    --about-subtitle-color: {{ section.settings.subtitle_color }};
    --about-button-bg: {{ section.settings.button_bg_color }};
    --about-button-text: {{ section.settings.button_text_color }};
    --about-button-hover-bg: {{ section.settings.button_hover_bg }};
    --about-button-hover-text: {{ section.settings.button_hover_text }};
    --about-padding-top: {{ section.settings.padding_top }}px;
    --about-padding-bottom: {{ section.settings.padding_bottom }}px;
    --about-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --about-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }

  .about-purpose-section {
    background: var(--about-bg-color);
    padding-top: var(--about-padding-top);
    padding-bottom: var(--about-padding-bottom);
  }

  .about-purpose-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0;
     max-width: 100%;
    margin: 0;
    min-height: {{ section.settings.section_min_height }}px;
  }

  .about-purpose-content {
    padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_right }}px {{ section.settings.content_padding_bottom }}px {{ section.settings.content_padding_left }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 100%;
  }

  .about-purpose-subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: var(--about-subtitle-color);
    text-transform: uppercase;
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
    font-weight: {{ section.settings.subtitle_font_weight }};
  }

  .about-purpose-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    color: var(--about-heading-color);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }};
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_text_transform }};
  }

  .about-purpose-text-blocks {
    display: flex;
    flex-direction: column;
  }

  .about-purpose-paragraph {
    font-size: {{ section.settings.paragraph_font_size }}px;
    color: var(--about-text-color);
    line-height: {{ section.settings.paragraph_line_height }};
    margin: 0 0 {{ section.settings.paragraph_margin_bottom }}px 0;
    font-weight: {{ section.settings.paragraph_font_weight }};
  }

  .about-purpose-subheading {
    font-size: {{ section.settings.subheading_font_size }}px;
    color: var(--about-heading-color);
    font-weight: {{ section.settings.subheading_font_weight }};
    margin: {{ section.settings.subheading_margin_top }}px 0 {{ section.settings.subheading_margin_bottom }}px 0;
  }

  .about-purpose-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--about-button-bg);
    color: var(--about-button-text);
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: {{ section.settings.button_margin_top }}px;
    width: fit-content;
    border-radius: {{ section.settings.button_border_radius }}px;
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-transform: {{ section.settings.button_text_transform }};
  }

  .about-purpose-button:hover {
    background-color: var(--about-button-hover-bg);
    color: var(--about-button-hover-text);
  }

  .about-purpose-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: {{ section.settings.image_padding_top }}px;
    padding-bottom: {{ section.settings.image_padding_bottom }}px;
    padding-right: 0px;
    min-height: {{ section.settings.image_min_height }}px;
  }

  .about-purpose-image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
    display: block;
  }

  .about-purpose-placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-purpose-placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* Tablet Styles */
  @media screen and (max-width: 990px) {
    .about-purpose-container {
      grid-template-columns: {{ section.settings.tablet_layout }};
      min-height: auto;
    }

    .about-purpose-content {
      padding: 40px 30px;
      max-width: 100%;
    }

    .about-purpose-heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px;
    }

    .about-purpose-image-wrapper {
      min-height: 400px;
    }
  }

  /* Mobile Styles */
  @media screen and (max-width: 768px) {
    .about-purpose-section {
      padding-top: var(--about-padding-top-mobile);
      padding-bottom: var(--about-padding-bottom-mobile);
    }

    .about-purpose-container {
      grid-template-columns: 1fr;
    }

    .about-purpose-content {
      padding: {{ section.settings.content_padding_mobile }}px;
      order: {{ section.settings.mobile_content_order }};
    }

    .about-purpose-image-wrapper {
      order: {{ section.settings.mobile_image_order }};
      min-height: {{ section.settings.image_min_height_mobile }}px;
    }

    .about-purpose-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .about-purpose-subtitle {
      font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    }

    .about-purpose-paragraph {
      font-size: {{ section.settings.paragraph_font_size_mobile }}px;
    }

    .about-purpose-button {
      width: {{ section.settings.button_full_width_mobile | default: 'fit-content' }};
      justify-content: center;
    }
  }

  /* Small Mobile */
  @media screen and (max-width: 480px) {
    .about-purpose-content {
      padding: {{ section.settings.content_padding_small_mobile }}px;
    }

    .about-purpose-image-wrapper {
      min-height: {{ section.settings.image_min_height_small_mobile }}px;
      padding: 10px;
    }
  }
</style>

