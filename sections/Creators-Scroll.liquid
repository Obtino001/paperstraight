<section class="creators-section section-{{ section.id }}">
  <div class="creators-header">
    {% if section.settings.heading != blank %}
      <h2 class="creators-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="creators-subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="creators-slider-wrapper">
    <div class="creators-slider" data-speed="{{ section.settings.scroll_speed }}" data-direction="{{ section.settings.scroll_direction }}" data-pause-hover="{{ section.settings.pause_on_hover }}">
      <div class="creators-track">
        <!-- First set of items -->
        {% for block in section.blocks %}
          <div class="creator-item" {{ block.shopify_attributes }}>
            <div class="creator-image-wrapper">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                          {{ block.settings.image | image_url: width: 450 }} 450w,
                          {{ block.settings.image | image_url: width: 600 }} 600w"
                  alt="{{ block.settings.username | default: 'Creator' }}"
                  class="creator-image"
                  loading="lazy"
                >
              {% else %}
                <div class="creator-image-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            <div class="creator-info">
              <div class="creator-profile">
                {% if block.settings.profile_image != blank %}
                  <img 
                    src="{{ block.settings.profile_image | image_url: width: 80 }}"
                    alt="{{ block.settings.username }}"
                    class="creator-profile-image"
                  >
                {% else %}
                  <div class="creator-profile-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                {% endif %}
                <span class="creator-username">{{ block.settings.username | default: 'username' }}</span>
              </div>
              <a href="{{ block.settings.follow_link | default: '#' }}" class="creator-follow-btn" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ section.settings.follow_button_text }}
              </a>
            </div>
          </div>
        {% endfor %}

        <!-- Duplicate set for seamless loop -->
        {% for block in section.blocks %}
          <div class="creator-item" aria-hidden="true">
            <div class="creator-image-wrapper">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                          {{ block.settings.image | image_url: width: 450 }} 450w,
                          {{ block.settings.image | image_url: width: 600 }} 600w"
                  alt="{{ block.settings.username | default: 'Creator' }}"
                  class="creator-image"
                  loading="lazy"
                >
              {% else %}
                <div class="creator-image-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            <div class="creator-info">
              <div class="creator-profile">
                {% if block.settings.profile_image != blank %}
                  <img 
                    src="{{ block.settings.profile_image | image_url: width: 80 }}"
                    alt="{{ block.settings.username }}"
                    class="creator-profile-image"
                  >
                {% else %}
                  <div class="creator-profile-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                {% endif %}
                <span class="creator-username">{{ block.settings.username | default: 'username' }}</span>
              </div>
              <a href="{{ block.settings.follow_link | default: '#' }}" class="creator-follow-btn" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %} tabindex="-1">
                {{ section.settings.follow_button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --creators-bg: {{ section.settings.background_color }};
    --creators-heading-color: {{ section.settings.heading_color }};
    --creators-subheading-color: {{ section.settings.subheading_color }};
    --creators-info-bg: {{ section.settings.info_bg_color }};
    --creators-username-color: {{ section.settings.username_color }};
    --creators-btn-bg: {{ section.settings.button_bg_color }};
    --creators-btn-text: {{ section.settings.button_text_color }};
    --creators-btn-border: {{ section.settings.button_border_color }};
    --creators-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --creators-btn-hover-text: {{ section.settings.button_hover_text }};
    --creators-btn-hover-border: {{ section.settings.button_hover_border }};
  }

  .creators-section {
    background: var(--creators-bg);
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    overflow: hidden;
    margin: 0 20px 0 20px;
  }

  .creators-header {
    text-align: {{ section.settings.header_alignment }};
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto {{ section.settings.header_margin_bottom }}px;
    padding: 0 {{ section.settings.header_padding_x }}px;
  }

  .creators-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: var(--creators-heading-color);
    text-transform: {{ section.settings.heading_text_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: 100%;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
  }

  .creators-subheading {
    font-size: {{ section.settings.subheading_font_size }}px;
    font-weight: {{ section.settings.subheading_font_weight }};
    color: var(--creators-subheading-color);
    margin: 0;
    line-height: 1.5;
  }

  .creators-slider-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .creators-slider {
    width: 100%;
  }

  .creators-track {
    display: flex;
    gap: {{ section.settings.items_gap }}px;
    width: max-content;
    animation: creatorsScroll {{ section.settings.scroll_speed }}s linear infinite;
  }

  .creators-slider[data-direction="right"] .creators-track {
    animation-direction: reverse;
  }

  .creators-slider.paused .creators-track {
    animation-play-state: paused;
  }

  @keyframes creatorsScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .creator-item {
    flex-shrink: 0;
    width: {{ section.settings.item_width }}px;
  }

  .creator-image-wrapper {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    position: relative;
  }

  .creator-image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
    transition: transform 0.4s ease;
  }

  .creator-item:hover .creator-image {
    transform: scale({{ section.settings.image_hover_scale }});
  }

  .creator-image-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .creator-image-placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .creator-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ section.settings.info_padding_y }}px {{ section.settings.info_padding_x }}px;
    background-color: var(--creators-info-bg);
    gap: 10px;
  }

  .creator-profile {
    display: flex;
    align-items: center;
    gap: {{ section.settings.profile_gap }}px;
    min-width: 0;
  }

  .creator-profile-image {
    width: {{ section.settings.profile_image_size }}px;
    height: {{ section.settings.profile_image_size }}px;
    border-radius: 0%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .creator-profile-placeholder {
    width: {{ section.settings.profile_image_size }}px;
    height: {{ section.settings.profile_image_size }}px;
    border-radius: 50%;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #999;
  }

  .creator-username {
    font-size: {{ section.settings.username_font_size }}px;
    font-weight: {{ section.settings.username_font_weight }};
    color: var(--creators-username-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: {{ section.settings.username_text_transform }};
    line-height: 100%;
  }

  .creator-follow-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    color: var(--creators-btn-text);
    background-color: var(--creators-btn-bg);
    border: {{ section.settings.button_border_width }}px solid var(--creators-btn-border);
    text-decoration: none;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    line-height: 100%;
  }

  .creator-follow-btn:hover {
    background-color: var(--creators-btn-hover-bg);
    color: var(--creators-btn-hover-text);
    border-color: var(--creators-btn-hover-border);
  }

  /* Tablet Styles */
  @media screen and (max-width: 990px) {
    .creators-heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px;
    }

    .creators-subheading {
      font-size: {{ section.settings.subheading_font_size_tablet }}px;
    }

    .creator-item {
      width: {{ section.settings.item_width_tablet }}px;
    }

    .creator-image-wrapper {
      height: {{ section.settings.image_height_tablet }}px;
    }

    .creators-track {
      gap: {{ section.settings.items_gap_tablet }}px;
    }
  }

  /* Mobile Styles */
  @media screen and (max-width: 768px) {
    .creators-section {
      padding: {{ section.settings.section_padding_top_mobile }}px 0 {{ section.settings.section_padding_bottom_mobile }}px;
      margin: 0 10px 0 10px;
    }

    .creators-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .creators-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }

    .creators-header {
      margin-bottom: {{ section.settings.header_margin_bottom_mobile }}px;
      padding: 0 {{ section.settings.header_padding_x_mobile }}px;
    }

    .creator-item {
      width: {{ section.settings.item_width_mobile }}px;
    }

    .creator-image-wrapper {
      height: {{ section.settings.image_height_mobile }}px;
    }

    .creators-track {
      gap: {{ section.settings.items_gap_mobile }}px;
    }

    .creator-info {
      padding: {{ section.settings.info_padding_y_mobile }}px {{ section.settings.info_padding_x_mobile }}px;
      {% comment %} flex-wrap: nowrap; {% endcomment %}
      flex-direction: column;
      align-items: flex-start;

    }

    .creator-username {
      font-size: {{ section.settings.username_font_size_mobile }}px;
    }

    .creator-follow-btn {
      font-size: {{ section.settings.button_font_size_mobile }}px;
      padding: {{ section.settings.button_padding_y_mobile }}px {{ section.settings.button_padding_x_mobile }}px;
      width:100%;
    }

    .creator-profile-image,
    .creator-profile-placeholder {
      width: {{ section.settings.profile_image_size_mobile }}px;
      height: {{ section.settings.profile_image_size_mobile }}px;
    }
  }

  /* Small Mobile */
  @media screen and (max-width: 480px) {
    .creator-item {
      width: {{ section.settings.item_width_small_mobile }}px;
    }

    .creator-image-wrapper {
      height: {{ section.settings.image_height_small_mobile }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.querySelector('.section-{{ section.id }} .creators-slider');
    if (!slider) return;

    const pauseOnHover = slider.dataset.pauseHover === 'true';

    if (pauseOnHover) {
      slider.addEventListener('mouseenter', function() {
        this.classList.add('paused');
      });

      slider.addEventListener('mouseleave', function() {
        this.classList.remove('paused');
      });

      // Touch devices
      slider.addEventListener('touchstart', function() {
        this.classList.add('paused');
      }, { passive: true });

      slider.addEventListener('touchend', function() {
        this.classList.remove('paused');
      }, { passive: true });
    }
  });
</script>

