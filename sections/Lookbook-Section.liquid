<section class="lookbook-section section-{{ section.id }}">
  <div class="lookbook-container container">
    <!-- Left Content -->
    <div class="lookbook-content">
      <div class="lookbook-content-inner">
        {% if section.settings.heading != blank %}
          <h2 class="lookbook-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="lookbook-text-blocks">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'paragraph' %}
                <p class="lookbook-paragraph">{{ block.settings.text }}</p>
              
              {% when 'button' %}
                <a href="{{ block.settings.button_link }}" class="lookbook-button" {{ block.shopify_attributes }} {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                  {{ block.settings.button_text }}
                </a>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Right Images - Desktop -->
    <div class="lookbook-images lookbook-images--desktop">
      <div class="lookbook-image-wrapper lookbook-image-1">
        {% if section.settings.image_1 != blank %}
          <img 
            src="{{ section.settings.image_1 | image_url: width: 800 }}"
            srcset="{{ section.settings.image_1 | image_url: width: 400 }} 400w,
                    {{ section.settings.image_1 | image_url: width: 600 }} 600w,
                    {{ section.settings.image_1 | image_url: width: 800 }} 800w,
                    {{ section.settings.image_1 | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="{{ section.settings.image_1_alt | default: section.settings.heading }}"
            class="lookbook-image"
            loading="lazy"
          >
        {% else %}
          <div class="lookbook-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="lookbook-image-wrapper lookbook-image-2">
        {% if section.settings.image_2 != blank %}
          <img 
            src="{{ section.settings.image_2 | image_url: width: 800 }}"
            srcset="{{ section.settings.image_2 | image_url: width: 400 }} 400w,
                    {{ section.settings.image_2 | image_url: width: 600 }} 600w,
                    {{ section.settings.image_2 | image_url: width: 800 }} 800w,
                    {{ section.settings.image_2 | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="{{ section.settings.image_2_alt | default: section.settings.heading }}"
            class="lookbook-image"
            loading="lazy"
          >
        {% else %}
          <div class="lookbook-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Mobile Image 1 (Top) -->
    <div class="lookbook-mobile-image lookbook-mobile-image-1">
      {% if section.settings.image_1_mobile != blank %}
        <img 
          src="{{ section.settings.image_1_mobile | image_url: width: 800 }}"
          srcset="{{ section.settings.image_1_mobile | image_url: width: 400 }} 400w,
                  {{ section.settings.image_1_mobile | image_url: width: 600 }} 600w,
                  {{ section.settings.image_1_mobile | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ section.settings.image_1_alt | default: section.settings.heading }}"
          class="lookbook-image"
          loading="lazy"
        >
      {% elsif section.settings.image_1 != blank %}
        <img 
          src="{{ section.settings.image_1 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_1 | image_url: width: 400 }} 400w,
                  {{ section.settings.image_1 | image_url: width: 600 }} 600w,
                  {{ section.settings.image_1 | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ section.settings.image_1_alt | default: section.settings.heading }}"
          class="lookbook-image"
          loading="lazy"
        >
      {% else %}
        <div class="lookbook-placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <!-- Mobile Image 2 (Bottom) -->
    <div class="lookbook-mobile-image lookbook-mobile-image-2">
      {% if section.settings.image_2_mobile != blank %}
        <img 
          src="{{ section.settings.image_2_mobile | image_url: width: 800 }}"
          srcset="{{ section.settings.image_2_mobile | image_url: width: 400 }} 400w,
                  {{ section.settings.image_2_mobile | image_url: width: 600 }} 600w,
                  {{ section.settings.image_2_mobile | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ section.settings.image_2_alt | default: section.settings.heading }}"
          class="lookbook-image"
          loading="lazy"
        >
      {% elsif section.settings.image_2 != blank %}
        <img 
          src="{{ section.settings.image_2 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_2 | image_url: width: 400 }} 400w,
                  {{ section.settings.image_2 | image_url: width: 600 }} 600w,
                  {{ section.settings.image_2 | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ section.settings.image_2_alt | default: section.settings.heading }}"
          class="lookbook-image"
          loading="lazy"
        >
      {% else %}
        <div class="lookbook-placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --lookbook-bg-color: {{ section.settings.content_bg_color }};
    --lookbook-text-color: {{ section.settings.text_color }};
    --lookbook-heading-color: {{ section.settings.heading_color }};
    --lookbook-button-bg: {{ section.settings.button_bg_color }};
    --lookbook-button-text: {{ section.settings.button_text_color }};
    --lookbook-button-border: {{ section.settings.button_border_color }};
    --lookbook-button-hover-bg: {{ section.settings.button_hover_bg }};
    --lookbook-button-hover-text: {{ section.settings.button_hover_text }};
    --lookbook-button-hover-border: {{ section.settings.button_hover_border }};
  }

  .lookbook-section {
    width: 100%;
  }

  .lookbook-container {
    display: grid;
    grid-template-columns: {{ section.settings.content_width }}% 1fr;
    min-height: {{ section.settings.section_min_height }}px;
  }

  .lookbook-content {
    background-color: var(--lookbook-bg-color);
    display: flex;
    align-items: {{ section.settings.content_vertical_align }};
    padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_right }}px {{ section.settings.content_padding_bottom }}px {{ section.settings.content_padding_left }}px;
    justify-content: center;
  }

  .lookbook-content-inner {
    max-width: 100%;
  }

  .lookbook-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    color: var(--lookbook-heading-color);
    font-weight: {{ section.settings.heading_font_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: {{ section.settings.heading_line_height }};
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    text-transform: {{ section.settings.heading_text_transform }};
  }

  .lookbook-text-blocks {
    display: flex;
    flex-direction: column;
  }

  .lookbook-paragraph {
    font-size: {{ section.settings.paragraph_font_size }}px;
    color: var(--lookbook-text-color);
    line-height: {{ section.settings.paragraph_line_height }};
    margin: 0 0 {{ section.settings.paragraph_margin_bottom }}px 0;
    font-weight: {{ section.settings.paragraph_font_weight }};
  }

  .lookbook-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--lookbook-button-bg);
    color: var(--lookbook-button-text);
    border: {{ section.settings.button_border_width }}px solid var(--lookbook-button-border);
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: {{ section.settings.button_margin_top }}px;
    width: fit-content;
    border-radius: {{ section.settings.button_border_radius }}px;
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-transform: {{ section.settings.button_text_transform }};
  }

  .lookbook-button:hover {
    background-color: var(--lookbook-button-hover-bg);
    color: var(--lookbook-button-hover-text);
    border-color: var(--lookbook-button-hover-border);
  }

  /* Images Container - Desktop */
  .lookbook-images--desktop {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.images_gap }}px;
  }

  .lookbook-image-wrapper {
    position: relative;
    overflow: hidden;
    min-height: {{ section.settings.image_min_height }}px;
  }

  .lookbook-image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .lookbook-image-1 .lookbook-image {
    object-position: {{ section.settings.image_1_position }};
  }

  .lookbook-image-2 .lookbook-image {
    object-position: {{ section.settings.image_2_position }};
  }

  .lookbook-placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lookbook-placeholder svg {
    width: 80%;
    height: 80%;
    opacity: 0.3;
  }

  /* Mobile Images - Hidden on Desktop */
  .lookbook-mobile-image {
    display: none;
  }

  /* Tablet Styles */
  @media screen and (max-width: 990px) {
    .lookbook-container {
      grid-template-columns: {{ section.settings.tablet_content_width }}% 1fr;
      min-height: auto;
    }

    .lookbook-heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px;
    }

    .lookbook-paragraph {
      font-size: {{ section.settings.paragraph_font_size_tablet }}px;
    }

    .lookbook-content {
      padding: {{ section.settings.content_padding_tablet }}px;
    }

    .lookbook-images--desktop {
      gap: {{ section.settings.images_gap_tablet }}px;
    }

    .lookbook-image-wrapper {
      min-height: {{ section.settings.image_min_height_tablet }}px;
    }
  }

  /* Mobile Styles */
  @media screen and (max-width: 768px) {
    .lookbook-container {
      display: flex;
      flex-direction: column;
    }

    /* Hide desktop images */
    .lookbook-images--desktop {
      display: none;
    }

    /* Show mobile images */
    .lookbook-mobile-image {
      display: block;
      width: 100%;
      min-height: {{ section.settings.image_min_height_mobile }}px;
      overflow: hidden;
    }

    .lookbook-mobile-image .lookbook-image {
      width: 100%;
      height: 100%;
      min-height: {{ section.settings.image_min_height_mobile }}px;
      object-fit: {{ section.settings.image_fit }};
    }

    .lookbook-mobile-image-1 .lookbook-image {
      object-position: {{ section.settings.image_1_position }};
    }

    .lookbook-mobile-image-2 .lookbook-image {
      object-position: {{ section.settings.image_2_position }};
    }

    /* Order: Image 1 > Content > Image 2 */
    .lookbook-mobile-image-1 {
      order: 1;
    }

    .lookbook-content {
      order: 2;
      padding: {{ section.settings.content_padding_mobile }}px;
      text-align: center;
      align-items: center;
      justify-content: center;
    }

    .lookbook-content-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .lookbook-text-blocks {
      align-items: flex-start;
      text-align: left;
    }

    .lookbook-mobile-image-2 {
      order: 3;
    }

    .lookbook-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .lookbook-paragraph {
      font-size: {{ section.settings.paragraph_font_size_mobile }}px;
    }

    .lookbook-button {
      {% if section.settings.button_full_width_mobile %}
        width: 100%;
      {% endif %}
    }
  }

  /* Small Mobile */
  @media screen and (max-width: 480px) {
    .lookbook-content {
      padding: {{ section.settings.content_padding_small_mobile }}px 27px;
    }

    .lookbook-mobile-image {
      min-height: {{ section.settings.image_min_height_small_mobile }}px;
    }

    .lookbook-mobile-image .lookbook-image {
      min-height: {{ section.settings.image_min_height_small_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Lookbook Section",
  "tag": "section",
  "class": "lookbook-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A/W' 25"
    },
    {
      "type": "header",
      "content": "Desktop Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (Left)"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 Alt Text"
    },
    {
      "type": "select",
      "id": "image_1_position",
      "label": "Image 1 Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (Right)"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 Alt Text"
    },
    {
      "type": "select",
      "id": "image_2_position",
      "label": "Image 2 Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Mobile Images (Optional)"
    },
    {
      "type": "paragraph",
      "content": "If not set, desktop images will be used on mobile."
    },
    {
      "type": "image_picker",
      "id": "image_1_mobile",
      "label": "Mobile Image 1 (Top)"
    },
    {
      "type": "image_picker",
      "id": "image_2_mobile",
      "label": "Mobile Image 2 (Bottom)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Content Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button Colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button Hover Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button Hover Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_border",
      "label": "Button Hover Border",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size",
      "min": 24,
      "max": 120,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_tablet",
      "label": "Heading Font Size (Tablet)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "min": 18,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "min": -5,
      "max": 15,
      "step": 0.5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading Margin Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Paragraph Typography"
    },
    {
      "type": "range",
      "id": "paragraph_font_size",
      "label": "Paragraph Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "paragraph_font_size_tablet",
      "label": "Paragraph Font Size (Tablet)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "paragraph_font_size_mobile",
      "label": "Paragraph Font Size (Mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "paragraph_line_height",
      "label": "Paragraph Line Height",
      "min": 1.2,
      "max": 2.5,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "select",
      "id": "paragraph_font_weight",
      "label": "Paragraph Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "paragraph_margin_bottom",
      "label": "Paragraph Margin Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "button_padding_x",
