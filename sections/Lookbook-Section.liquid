      "type": "range",
      "id": "images_gap",
      "label": "Gap Between Images",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "images_gap_tablet",
      "label": "Gap Between Images (Tablet)",
      "min": 0,
      "max": 20,
      "step": 1,
