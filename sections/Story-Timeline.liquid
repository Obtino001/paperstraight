<section class="story-timeline-section section-{{ section.id }} container">
  <!-- Section Heading -->
  {% if section.settings.section_heading != blank %}
    <div class="story-timeline-header">
      <h2 class="story-timeline-main-heading">{{ section.settings.section_heading }}</h2>
    </div>
  {% endif %}

  <div class="story-timeline-container">
    <!-- Left Side - Single Image -->
    <div class="story-timeline-image">
      <!-- Desktop Image -->
      <div class="story-image-desktop">
        {% if section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 900 }} 900w,
                    {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 768px) 100vw, 55vw"
            alt="{{ section.settings.image_alt | default: section.settings.section_heading }}"
            class="story-main-image"
            loading="lazy"
          >
        {% else %}
          <div class="story-image-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <!-- Mobile Image -->
      <div class="story-image-mobile">
        {% if section.settings.image_mobile != blank %}
          <img 
            src="{{ section.settings.image_mobile | image_url: width: 800 }}"
            srcset="{{ section.settings.image_mobile | image_url: width: 400 }} 400w,
                    {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
                    {{ section.settings.image_mobile | image_url: width: 800 }} 800w"
            sizes="100vw"
            alt="{{ section.settings.image_alt | default: section.settings.section_heading }}"
            class="story-main-image"
            loading="lazy"
          >
        {% elsif section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                    {{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 800 }} 800w"
            sizes="100vw"
            alt="{{ section.settings.image_alt | default: section.settings.section_heading }}"
            class="story-main-image"
            loading="lazy"
          >
        {% else %}
          <div class="story-image-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Right Side - Timeline -->
    <div class="story-timeline-content">
      <div class="story-timeline-items">
        {% assign timeline_blocks = section.blocks | where: "type", "timeline_item" %}
        {% for block in timeline_blocks %}
          <div class="story-timeline-item {% if forloop.first %}active{% endif %} {% if forloop.last %}last-item{% endif %}" data-timeline-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% comment %} <div class="story-timeline-marker">
              <span class="story-marker-box"></span>
              {% unless forloop.last %}
                <span class="story-marker-line"></span>
              {% endunless %}
            </div> {% endcomment %}
            <div class="story-timeline-marker">
              <span class="story-marker-box"></span>
              <span class="story-marker-line"></span>
            </div>

            <div class="story-timeline-text">
              {% if block.settings.date != blank %}
                <span class="story-timeline-date">{{ block.settings.date }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="story-timeline-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.subtitle != blank %}
                <p class="story-timeline-subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}
              {% if block.settings.description != blank %}
                <div class="story-timeline-description">{{ block.settings.description }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Bottom CTA Card -->
      {% assign cta_block = section.blocks | where: "type", "cta_card" | first %}
      {% if cta_block %}
        <div class="story-timeline-cta" {{ cta_block.shopify_attributes }}>
          {% if cta_block.settings.heading != blank %}
            <h4 class="story-cta-heading">{{ cta_block.settings.heading }}</h4>
          {% endif %}
          {% if cta_block.settings.subtext != blank %}
            <p class="story-cta-subtext">{{ cta_block.settings.subtext }}</p>
          {% endif %}
          {% if cta_block.settings.description != blank %}
            <p class="story-cta-description">{{ cta_block.settings.description }}</p>
          {% endif %}
          {% if cta_block.settings.button_text != blank %}
            <a href="{{ cta_block.settings.button_link }}" class="story-cta-button" {% if cta_block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ cta_block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --story-bg-color: {{ section.settings.background_color }};
    --story-text-color: {{ section.settings.text_color }};
    --story-heading-color: {{ section.settings.heading_color }};
    --story-date-color: {{ section.settings.date_color }};
    --story-title-color: {{ section.settings.title_color }};
    --story-marker-inactive: {{ section.settings.marker_inactive_color }};
    --story-marker-active: {{ section.settings.marker_active_color }};
    --story-line-color: {{ section.settings.line_color }};
    --story-cta-bg: {{ section.settings.cta_bg_color }};
    --story-cta-text: {{ section.settings.cta_text_color }};
    --story-button-bg: {{ section.settings.button_bg_color }};
    --story-button-text: {{ section.settings.button_text_color }};
    --story-button-border: {{ section.settings.button_border_color }};
    --story-button-hover-bg: {{ section.settings.button_hover_bg }};
    --story-button-hover-text: {{ section.settings.button_hover_text }};
  }

  .story-timeline-section {
    background-color: var(--story-bg-color);
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_x }}px {{ section.settings.section_padding_bottom }}px;
  }

  .story-timeline-header {
    max-width: 1600px;
    margin: 0;
    padding: 0 0px 10px;
  }

  .story-timeline-main-heading {
    font-size: {{ section.settings.main_heading_size }}px;
    font-weight: {{ section.settings.main_heading_weight }};
    color: var(--story-heading-color);
    margin: 0;
    text-transform: {{ section.settings.main_heading_transform }};
    letter-spacing: {{ section.settings.main_heading_spacing }}px;
  }

  .story-timeline-container {
    display: grid;
    grid-template-columns: {{ section.settings.image_width }}% {{ section.settings.content_width }}%;
    gap: {{ section.settings.container_gap }}px;
    max-width: {{ section.settings.container_max_width }}px;
    {% comment %} margin: 0 auto; {% endcomment %}
    padding: 0 {{ section.settings.container_padding }}px;
    align-items: start;
  }

  /* Left Side - Image */
  .story-timeline-image {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    height: fit-content;
  }

  .story-image-desktop {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .story-image-mobile {
    display: none;
  }

  .story-main-image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  .story-image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-image-placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  /* Right Side - Timeline */
  .story-timeline-content {
    padding: {{ section.settings.timeline_padding_top }}px 15px {{ section.settings.timeline_padding_bottom }}px 0;
  }

  .story-timeline-items {
    display: flex;
    flex-direction: column;
  }

  .story-timeline-item {
    display: grid;
    grid-template-columns: {{ section.settings.marker_column_width }}px 1fr;
    gap: {{ section.settings.marker_text_gap }}px;
    opacity: 1;
    transition: opacity 0.3s ease;
    padding-bottom: {{ section.settings.timeline_items_gap }}px;
  }

  .story-timeline-item.last-item {
    padding-bottom: 0;
  }

  .story-timeline-item.active {
    opacity: 1;
  }

  /* Timeline Marker with Line */
  .story-timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .story-marker-box {
    width: {{ section.settings.marker_size }}px;
    height: {{ section.settings.marker_size }}px;
    border: {{ section.settings.marker_border_width }}px solid var(--story-marker-inactive);
    background-color: transparent;
    transition: all 0.3s ease;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
        display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-timeline-item.active .story-marker-box:after {
    content: "";
    width: {{ section.settings.marker_size | minus: 8 }}px;
    height: {{ section.settings.marker_size | minus: 8 }}px;
    background-color: var(--story-marker-active);
    border-color: var(--story-marker-active);
  }

  /* Vertical Connecting Line */
  .story-marker-line {
    width: {{ section.settings.line_width }}px;
    flex-grow: 1;
    background-color: var(--story-line-color);
    margin-top: {{ section.settings.line_gap_top }}px;
    min-height: 20px;
  }

  .story-timeline-text {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.text_gap }}px;
    padding-top: 0;
  }

  .story-timeline-date {
    font-size: {{ section.settings.date_font_size }}px;
    color: var(--story-date-color);
    font-weight: {{ section.settings.date_font_weight }};
    text-transform: {{ section.settings.date_text_transform }};
    letter-spacing: {{ section.settings.date_letter_spacing }}px;
  }

  .story-timeline-title {
    font-size: {{ section.settings.title_font_size }}px;
    color: var(--story-title-color);
    font-weight: {{ section.settings.title_font_weight }};
    text-transform: {{ section.settings.title_text_transform }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    margin: 0;
    line-height: 1.3;
  }

  .story-timeline-subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: var(--story-text-color);
    font-weight: {{ section.settings.subtitle_font_weight }};
    font-style: {{ section.settings.subtitle_font_style }};
    margin: 0;
    line-height: 1.4;
  }

  .story-timeline-description {
    font-size: {{ section.settings.description_font_size }}px;
    color: var(--story-text-color);
    font-weight: {{ section.settings.description_font_weight }};
    line-height: {{ section.settings.description_line_height }};
    margin: 0;
  }

  /* CTA Card */
  .story-timeline-cta {
    background-color: var(--story-cta-bg);
    padding: {{ section.settings.cta_padding }}px;
    margin-top: {{ section.settings.cta_margin_top }}px;
  }
  .story-timeline-cta p{
    font-size: {{ section.settings.cta_description_size }}px;
    color: var(--story-cta-text);
    line-height: 1.6;
  }

  .story-cta-heading {
    font-size: {{ section.settings.cta_heading_size }}px;
    font-weight: {{ section.settings.cta_heading_weight }};
    color: var(--story-cta-text);
    margin: 0 0 {{ section.settings.cta_heading_margin }}px 0;
    line-height: 1.3;
  }

  .story-cta-subtext {
    font-size: {{ section.settings.cta_subtext_size }}px;
    color: var(--story-cta-text);
    margin: 0 0 {{ section.settings.cta_subtext_margin }}px 0;
    opacity: 0.8;
  }

  .story-cta-description {
    font-size: {{ section.settings.cta_description_size }}px;
    color: var(--story-cta-text);
    line-height: 1.6;
    margin: 0 0 {{ section.settings.cta_description_margin }}px 0;
  }

  .story-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--story-button-bg);
    color: var(--story-button-text);
    border: {{ section.settings.button_border_width }}px solid var(--story-button-border);
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    margin-top: 20px;
  }

  .story-cta-button:hover {
    background-color: var(--story-button-hover-bg);
    color: var(--story-button-hover-text);
  }

  @media (min-width: 991px) and (max-width: 1299px) {
    .story-timeline-container {
      grid-template-columns: 60% 33%;
    }
  }

  /* Tablet Styles */
  @media screen and (max-width: 990px) {
    .story-timeline-container {
      grid-template-columns: 50% 46%;
      gap: {{ section.settings.tablet_gap }}px;
    }
    .story-timeline-content {
      padding: 0;
    }

    .story-image-desktop {
      height: {{ section.settings.image_height_tablet }}px;
    }

    .story-timeline-main-heading {
      font-size: {{ section.settings.main_heading_size_tablet }}px;
    }

    .story-timeline-title {
      font-size: {{ section.settings.title_font_size_tablet }}px;
    }

    .story-timeline-description {
      font-size: {{ section.settings.description_font_size_tablet }}px;
    }
  }

  /* Mobile Styles */
  @media screen and (max-width: 768px) {
    .story-timeline-section {
      padding: {{ section.settings.section_padding_top_mobile }}px {{ section.settings.section_padding_x_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px;
    }

    .story-timeline-container {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }
    .story-timeline-text {
      text-align: center;
    }

    .story-timeline-image {
      position: relative;
      top: 0;
      order: {{ section.settings.mobile_image_order }};
      display: none;
    }

    .story-image-desktop {
      display: none;
    }

    .story-image-mobile {
      display: block;
      width: 100%;
      height: {{ section.settings.image_height_mobile }}px;
      overflow: hidden;
    }

    .story-timeline-content {
      order: {{ section.settings.mobile_content_order }};
      padding: {{ section.settings.timeline_padding_mobile }}px 0;
    }

    .story-timeline-main-heading {
      font-size: {{ section.settings.main_heading_size_mobile }}px;
      text-align: center;
    }

    .story-timeline-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }

    .story-timeline-date {
      font-size: {{ section.settings.date_font_size_mobile }}px;
    }

    .story-timeline-description {
      font-size: {{ section.settings.description_font_size_mobile }}px;
    }

    .story-timeline-item {
      padding-bottom: {{ section.settings.timeline_items_gap_mobile }}px;
    }

    .story-cta-heading {
      font-size: {{ section.settings.cta_heading_size_mobile }}px;
    }

    .story-timeline-cta {
      padding: {{ section.settings.cta_padding_mobile }}px;
    }
  }

  /* Small Mobile */
  @media screen and (max-width: 480px) {
    .story-image-mobile {
      height: {{ section.settings.image_height_small_mobile }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    const timelineItems = section.querySelectorAll('.story-timeline-item');
    
    if (timelineItems.length === 0) return;

    let currentIndex = 0;

    // Function to update active states
    function setActiveIndex(index) {
      if (index < 0 || index >= timelineItems.length || index === currentIndex) return;
      
      // Update timeline items
      timelineItems.forEach((item, i) => {
        item.classList.toggle('active', i === index);
      });

      currentIndex = index;
    }

    // Timeline item click handlers
    timelineItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        setActiveIndex(index);
      });
      item.style.cursor = 'pointer';
    });

    // Intersection Observer for scroll-based activation
    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -30% 0px',
      threshold: 0.5
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = parseInt(entry.target.dataset.timelineIndex);
          setActiveIndex(index);
        }
      });
    }, observerOptions);

    timelineItems.forEach(item => {
      observer.observe(item);
    });

    // Initial state
    setActiveIndex(0);
  });
</script>

{% schema %}
{
  "name": "Story Timeline",
  "tag": "section",
  "class": "story-timeline-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "section_heading",
