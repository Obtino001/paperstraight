{%- style -%}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ button_font | font_face: font_display: 'swap' }}

  .custom-section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top }}px;
    margin-bottom: {{ margin_bottom }}px;
  }

  .custom-section-{{ section.id }}-settings {
    margin: 0 auto;
    padding: {{ padding_top }}px {{ padding_horizontal_mobile }}rem {{ padding_bottom }}px {{ padding_horizontal_mobile }}rem;
  }

  .custom-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: {{ layout_gap_mobile }}px;
    background-color: {{ layout_bg_color }};
    padding: {{ layout_padding_vertical_mobile }}px {{ layout_padding_horizontal_mobile }}px;
    border: {{ layout_border_thickness }}px solid {{ layout_border_color }};
    border-radius: {{ layout_radius }}px;
  }

  .custom-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    justify-content: {{ content_vertical_align_mobile }};
    padding: {{ card_padding_vertical_mobile }}px {{ card_padding_horizontal_mobile }}px;
    border: {{ card_border_thickness }}px solid {{ card_border_color }};
    border-radius: {{ card_radius }}px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .custom-item-{{ section.id }}:after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: {{ overlay_color | hex_to_rgba: overlay }};
    z-index: 1;
  }

  .custom-bg-{{ section.id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-title-{{ section.id }} {
    text-align: {{ title_align_mobile }};
    position: relative;
    z-index: 2;
    font-size: {{ title_size_mobile }}px;
    color: {{ title_color }};
    line-height: {{ title_height }}%;
  }

  .custom-button-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ button_size_mobile }}px;
    color: {{ button_color }};
    text-decoration: none;
    padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
    border-radius: {{ button_radius }}px;
    border: {{ button_border_thickness }}px solid {{ button_border_color }};
    background-color: {{ button_bg_color }};
    gap: {{ button_gap }}px;
    margin-top: {{ button_mt }}px;
    z-index: 2;
    transition: all 0.25s ease;
  }

  .custom-button-{{ section.id }}:hover {
    color: {{ button_hover_color }};
    border-color: {{ button_border_hover_color }};
    background-color: {{ button_bg_hover_color }};
  }
  
  .custom-item-{{ section.id }} {
    aspect-ratio: 12 / 12;
  }
  .custom-bg-{{ section.id }} {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 1;
  }

  @media(min-width: 768px) {
    .custom-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.blocks.size | divided_by:2 | round }}, 1fr);
    }
  }

  @media(min-width: 1024px) {
    .custom-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
      gap: {{ layout_gap }}px;
      padding: {{ layout_padding_vertical }}px {{ layout_padding_horizontal }}px;
    }

    .custom-item-{{ section.id }} {
      justify-content: {{ content_vertical_align }};
      padding: {{ card_padding_vertical }}px {{ card_padding_horizontal }}px;
    }

    .custom-title-{{ section.id }} {
      text-align: {{ title_align }};
      font-size: {{ title_size }}px;
    }

    .custom-button-{{ section.id }} {
      font-size: {{ button_size }}px;
      gap: {{ button_gap }}px;
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
    }
  }
{%- endstyle -%}

<div class="custom-section-{{ section.id }}" style="background-color:{{ background_color }}; background-image: {{ background_gradient }};">
  <div class="custom-section-{{ section.id }}-settings">
    <div class="custom-grid-{{ section.id }}">
      {% for block in section.blocks %}
      <a href="{% if block.settings.product != blank %}{{ block.settings.product.url }}{% else %}{{ block.settings.url }}{% endif %}" class="custom-item-{{ section.id }}">
        <div class="custom-bg-{{ section.id }}">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" {% if lazy %}loading="lazy"{% endif %}>
          {% elsif block.settings.product != blank %}
            <img src="{{ block.settings.product.featured_image | image_url }}" alt="{{ block.settings.product.featured_image.alt }}" {% if lazy %}loading="lazy"{% endif %}>
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        {% if block.settings.title != blank %}
        <div class="custom-title-{{ section.id }}">{{ block.settings.title }}</div>
        {% elsif block.settings.product.title != blank %}
        <div class="custom-title-{{ section.id }}"><h3>{{ block.settings.product.title }}</h3></div>
        {% endif %}

        {% if block.settings.button != blank %}
        <div class="custom-button-{{ section.id }}">
          {{ block.settings.button }}
          {% if button_icon %}
          <span class="custom-button-icon-{{ section.id }}">
            <svg width="24" height="24" viewBox="0 0 24 24"><path d="M3.75 12H20.25" stroke="white" stroke-width="2" stroke-linecap="round"/><path d="M13.5 5.25L20.25 12L13.5 18.75" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          {% endif %}
        </div>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</div>


