{{ 'masonry-gallery.css' | asset_url | stylesheet_tag }}

<div class="masonry-gallery-section" style="background-color: {{ section.settings.background_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="masonry-gallery-container container">
    {% if section.settings.heading != blank %}
        <h2 class="look_book_title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.descrptions != blank %}
        <div class="look_book_descrptions">
          {{ section.settings.descrptions }}
        </div>
      {% endif %}
    <div class="masonry-grid">
      {% for block in section.blocks %}
        <div class="masonry-item masonry-item--{{ block.settings.size }}" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="masonry-link">
          {% endif %}
          
          {% if block.settings.image != blank %}
            <img 
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 800 }} 800w,
                      {{ block.settings.image | image_url: width: 1000 }} 1000w"
              sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 25vw"
              alt="{{ block.settings.image.alt | default: 'Gallery image' }}"
              loading="lazy"
              class="masonry-image"
            >
          {% else %}
            <div class="masonry-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
          
          {% if block.settings.overlay_text != blank %}
            <div class="masonry-overlay">
              <span class="masonry-overlay-text">{{ block.settings.overlay_text }}</span>
            </div>
          {% endif %}
          
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  h2.look_book_title {
    font-size: 48px;
    line-height: 100%;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
  }

  .look_book_descrptions {
    font-size: 16px;
    margin-top: 5px;
    text-align: center;
    line-height: 100%;
    margin-bottom: 32px;
  }
  /* Masonry Gallery Section Styles */
.masonry-gallery-section {
  width: 100%;
  overflow: hidden;
}

.masonry-gallery-container {
  {% comment %} max-width: 1440px;
  padding: 0 20px; 
  margin: 0 auto;{% endcomment %}
  
}

/* Main Masonry Grid - Desktop Layout */
.masonry-grid {
  display: grid;
  {% comment %} grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(12, 1fr); {% endcomment %}
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: repeat(6, 1fr);
  gap: 8px;
  min-height: 700px;
  max-height: 900px;
  height: 90vh;
  width: 100%;
}

/* Column 1 - Full height tall image */
.masonry-grid .masonry-item:nth-child(1) {
  {% comment %} grid-column: 1;
  grid-row: 1 / 13; {% endcomment %}
  grid-column: 1 / span 4;
  grid-row: 1 / span 6;
}

/* Column 2 - First image (larger) */
.masonry-grid .masonry-item:nth-child(2) {
  {% comment %} grid-column: 2;
  grid-row: 1 / 7; {% endcomment %}
  grid-column: 5 / span 3;
  grid-row: 1 / span 3;
}

/* Column 2 - Second image (smaller) */
.masonry-grid .masonry-item:nth-child(3) {
  {% comment %} grid-column: 2;
  grid-row: 7 / 13; {% endcomment %}
  grid-column: 5 / span 3;
  grid-row: 4 / span 3;
}

/* Column 3 - First image (smaller) */
.masonry-grid .masonry-item:nth-child(4) {
  {% comment %} grid-column: 3;
  grid-row: 1 / 5; {% endcomment %}    
  grid-column: 8 / span 3;
  grid-row: 1 / span 2;
}

/* Column 3 - Second image (larger) */
.masonry-grid .masonry-item:nth-child(5) {
  {% comment %} grid-column: 3;
  grid-row: 5 / 13; {% endcomment %}
  grid-column: 8 / span 3;
  grid-row: 3 / span 4;
}

/* Column 4 - First image */
.masonry-grid .masonry-item:nth-child(6) {
  {% comment %} grid-column: 4;
  grid-row: 1 / 9; {% endcomment %}
  grid-column: 11 / span 2;
  grid-row: 1 / span 4;
}

/* Column 4 - Second image */
.masonry-grid .masonry-item:nth-child(7) {
  {% comment %} grid-column: 4;
  grid-row: 9 / 13; {% endcomment %}
  grid-column: 11 / span 2;
  grid-row: 5 / span 2;
}

/* Column 4 - Third image */
.masonry-grid .masonry-item:nth-child(8) {
  grid-column: 4;
  grid-row: 10 / 13;
}

/* Individual Item Styles */
.masonry-item {
  position: relative;
  overflow: hidden;
  border-radius: 0;
}

.masonry-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.masonry-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.4s ease;
}

{% comment %} .masonry-item:hover .masonry-image {
  transform: scale(1.05);
} {% endcomment %}

/* Placeholder Styles */
.masonry-placeholder {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.masonry-placeholder .placeholder-svg {
  width: 60%;
  height: 60%;
  opacity: 0.5;
}

/* Overlay Styles */
.masonry-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.masonry-item:hover .masonry-overlay {
  opacity: 1;
}

.masonry-overlay-text {
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ============================================
   TABLET LAYOUT (768px - 1024px)
   ============================================ */
@media screen and (max-width: 1024px) {
  .masonry-grid {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(12, 1fr);
    min-height: 600px;
    height: 75vh;
    max-height: 800px;
  }

  /* Column 1 - Tall image */
  .masonry-grid .masonry-item:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / 13;
  }

  /* Column 2 - First image */
  .masonry-grid .masonry-item:nth-child(2) {
    grid-column: 2;
    grid-row: 1 / 7;
  }

  /* Column 2 - Second image */
  .masonry-grid .masonry-item:nth-child(3) {
    grid-column: 2;
    grid-row: 7 / 13;
  }

  /* Column 3 - First image */
  .masonry-grid .masonry-item:nth-child(4) {
    grid-column: 3;
    grid-row: 1 / 5;
  }

  /* Column 3 - Second image */
  .masonry-grid .masonry-item:nth-child(5) {
    grid-column: 3;
    grid-row: 5 / 9;
  }

  /* Column 3 - Third image (was col 4) */
  .masonry-grid .masonry-item:nth-child(6) {
    grid-column: 3;
    grid-row: 9 / 13;
  }

  /* Hide remaining items on tablet if needed, or adjust */
  .masonry-grid .masonry-item:nth-child(7),
  .masonry-grid .masonry-item:nth-child(8) {
    display: none;
  }
}
/* ------------------------------
MOBILE: collapse into 2-column collage
------------------------------ */
@media (max-width: 900px) {
{% comment %} section#template--25461628141902__lookbook_masonry_grid_gkGXRr {
    padding-bottom: 68px !important;
    padding-top: 73px !important;
} {% endcomment %}
  h2.look_book_title {
      font-size: 24px;
  }
  .look_book_descrptions {
      margin-top: 13px;
      margin-bottom: 25px;
  }
}

/* ============================================
   MOBILE LANDSCAPE (481px - 767px)
   ============================================ */
@media screen and (max-width: 767px) {
  {% comment %} .masonry-gallery-container {
    padding: 0 15px;
  } {% endcomment %}

  .masonry-grid {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(16, 1fr);
    min-height: 500px;
    height: auto;
    max-height: none;
    gap: 8px;
  }

  /* Column 1 - First tall image */
  .masonry-grid .masonry-item:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / 9;
  }

  /* Column 2 - First image */
  .masonry-grid .masonry-item:nth-child(2) {
    grid-column: 2;
    grid-row: 1 / 5;
  }

  /* Column 2 - Second image */
  .masonry-grid .masonry-item:nth-child(3) {
    grid-column: 2;
    grid-row: 5 / 9;
  }

  /* Second row - Column 1 */
  .masonry-grid .masonry-item:nth-child(4) {
    grid-column: 1;
    grid-row: 9 / 13;
  }

  /* Second row - Column 2 */
  .masonry-grid .masonry-item:nth-child(5) {
    grid-column: 2;
    grid-row: 9 / 16;
  }

  /* Third row - Column 1 */
  .masonry-grid .masonry-item:nth-child(6) {
    grid-column: 1;
    grid-row: 13 / 16;
  }

  /* Hide remaining on smaller tablet */
  .masonry-grid .masonry-item:nth-child(7),
  .masonry-grid .masonry-item:nth-child(8) {
    display: none;
  }
}

/* ============================================
   MOBILE PORTRAIT (up to 480px)
   ============================================ */
@media screen and (max-width: 480px) {
  {% comment %} .masonry-gallery-container {
    padding: 0 10px;
  } {% endcomment %}

  .masonry-grid {
    grid-template-columns: 1.05fr 1fr;
    grid-auto-rows: 110px;
    grid-auto-flow: dense;
    gap: 8px;
    width: 100%;
    height: 100vh;
    grid-template-rows: repeat(6, 1fr);
    {% comment %} grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(18, 50px);
    gap: 6px;
    min-height: auto;
    height: auto; {% endcomment %}
  }

  /* Image 1 - Tall left */
  .masonry-grid .masonry-item:nth-child(1) {
    grid-column: 1 / 2;
    grid-row: span 7;
  }

  /* Image 2 - Right top */
  .masonry-grid .masonry-item:nth-child(2) {
    grid-column: 2 / 2;
    grid-row: span 6;
  }

  /* Image 3 - Right middle */
  .masonry-grid .masonry-item:nth-child(3) {
    grid-column: 1 / 2;
    grid-row: span 3;
  }

  /* Image 4 - Left middle */
  .masonry-grid .masonry-item:nth-child(4) {
    grid-column: 1;
    grid-row: 8 / 12;
    display:none;
  }

  /* Image 5 - Right tall */
  .masonry-grid .masonry-item:nth-child(5) {
    grid-column: 2 / 3;
    grid-row: span 3;
  }

  /* Image 6 - Left bottom */
  .masonry-grid .masonry-item:nth-child(6) {
    grid-column: 1 / 2;
    grid-row: span 2;
  }

  /* Image 7 - Bottom spanning */
  .masonry-grid .masonry-item:nth-child(7) {
    grid-column: 2 / 2;
    grid-row: span 3;
    display: block;
  }

  /* Image 8 - Bottom right */
  .masonry-grid .masonry-item:nth-child(8) {
    grid-column: 2;
    grid-row: 14 / 19;
    display: none;
  }

  .masonry-overlay {
    padding: 10px;
  }

  .masonry-overlay-text {
    font-size: 11px;
  }
}

/* ============================================
   EXTRA SMALL MOBILE (up to 360px)
   ============================================ */
@media screen and (max-width: 360px) {
  .masonry-grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: 6px;
  }

  .masonry-grid .masonry-item {
    grid-column: 1 !important;
    grid-row: auto !important;
    display: block !important;
    height: 280px;
  }

  .masonry-grid .masonry-item:nth-child(1) {
    height: 400px;
  }
}

/* ============================================
   LARGE DESKTOP (1440px+)
   ============================================ */
@media screen and (min-width: 1440px) {
  {% comment %} .masonry-gallery-container {
    max-width: 1900px;
    padding: 0 40px;
  } {% endcomment %}

  .masonry-grid {
    max-height: 950px;
    gap: 8px;
  }
}

/* ============================================
   ACCESSIBILITY & PERFORMANCE
   ============================================ */
@media (prefers-reduced-motion: reduce) {
  .masonry-image {
    transition: none;
  }
  
  .masonry-overlay {
    transition: none;
  }
}

/* Focus states for accessibility */
.masonry-link:focus {
  outline: 2px solid #000;
  outline-offset: 2px;
}

.masonry-link:focus-visible {
  outline: 2px solid #000;
  outline-offset: 2px;
}

/* Print styles */
@media print {
  .masonry-grid {
    display: block;
  }
  
  .masonry-item {
    page-break-inside: avoid;
    margin-bottom: 20px;
    height: auto !important;
  }
  
  .masonry-image {
    max-height: 300px;
    object-fit: contain;
  }
}
</style>

{% schema %}
{
  "name": "Image Gallery Grid",
  "tag": "section",
  "class": "masonry-gallery-wrapper",
  "settings": [
    {
      "type": "inline_richtext",
      "label": "Heading",
      "id": "heading"
    },
    {
      "type": "richtext",
      "label": "Descrptions",
      "id": "descrptions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Images",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Image Size",
          "options": [
            {
              "value": "tall",
              "label": "Tall (Full Height)"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "column",
          "label": "Column Position",
          "options": [
            {
              "value": "col-1",
              "label": "Column 1"
            },
            {
              "value": "col-2",
              "label": "Column 2"
            },
            {
              "value": "col-3",
              "label": "Column 3"
            },
            {
              "value": "col-4",
              "label": "Column 4"
            }
          ],
          "default": "col-1"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay Text (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery Grid",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "size": "tall",
            "column": "col-1"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "medium",
            "column": "col-2"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "medium",
            "column": "col-2"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "small",
            "column": "col-3"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "medium",
            "column": "col-3"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "medium",
            "column": "col-4"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "medium",
            "column": "col-4"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "small",
            "column": "col-4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
