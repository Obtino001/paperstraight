    "story_timeline_za7Y7K": {
      "type": "Story-Timeline",
      "blocks": {
        "timeline_item_rrVHdQ": {
          "type": "timeline_item",
          "settings": {
            "date": "Early 2024",
            "title": "The foundation of Paper Straight",
            "subtitle": "",
            "description": "<p>Late nights, early sketches, and the pursuit of balance, between utility and design, between classic and contemporary. What started as an idea for footwear that feels timeless, quickly became a vision for something more.</p>"
          }
        },
        "timeline_item_fkBNqh": {
          "type": "timeline_item",
          "settings": {
            "date": "Late 2024",
            "title": "The First Samples",
            "subtitle": "",
            "description": "<p>From sketches to steps. Our first prototypes were crafted, rough, honest, and full of potential. Each pair tested, refined, and worn through daily life until every stitch felt right.</p>"
          }
        },
        "timeline_item_DGchWE": {
          "type": "timeline_item",
          "settings": {
            "date": "Early 2025",
            "title": "The First Stock",
            "subtitle": "",
            "description": "<p>The beginning of movement.<br/><br/>The first Summit Derbys arrived, understated, sturdy, and built for those who move different. What followed wasn’t hype, it was connection. The start of a quiet community.</p>"
          }
        },
        "timeline_item_h3r3hR": {
          "type": "timeline_item",
          "settings": {
            "date": "Summer 2025",
            "title": "Launch of the First Collection",
            "subtitle": "",
            "description": "<p>Paper Straight goes live.<br/><br/>The debut collection brought structure to the vision: footwear, essentials, and form refined. The Summit Ridge joined the family, proof that craftsmanship and modern streetwear could share the same language.</p>"
          }
        },
        "timeline_item_KDjw7z": {
          "type": "timeline_item",
          "settings": {
            "date": "Winter 2025",
            "title": "The Evolution: Heritage Era",
            "subtitle": "",
            "description": "<p>Craft refined, character defined.<br/><br/>The Heritage Derby marks a new chapter, deeper materials, higher standards, and a quiet sense of confidence. Still Paper Straight at heart, only sharper.</p>"
          }
        },
        "cta_card_Mq4ywq": {
          "type": "cta_card",
          "settings": {
            "heading": "Looking Ahead Beyond Footwear",
            "subtext": "Paper Straight continues to evolve.",
            "description": "<p>More than products, it's a way of moving through the world. Built slowly, worn deliberately. Always forward, never rushed.</p>",
            "button_text": "ABOUT US",
            "button_link": "shopify://pages/about-us",
            "open_new_tab": false
          }
        }
      },
