    "lookbook_section_pqDU9G": {
      "type": "Lookbook-Section",
      "blocks": {
        "paragraph_rm9XdA": {
          "type": "paragraph",
          "settings": {
            "text": "Every Paper Straight shoe begins with a last, a wooden form shaped to define the silhouette before a single cut is made. From there, patterns are drawn by hand, leather is selected and cut with precision, and each panel is stitched together piece by piece."
          }
        },
        "paragraph_7tXJz9": {
          "type": "paragraph",
          "settings": {
            "text": "Our soles are molded in-house using custom Paper Straight tooling, designed for grip, durability and a profile that holds its shape over time. Metal hardware is set by hand. Insoles are branded and layered for comfort. Every pair passes through dozens of hands before it reaches yours."
          }
        },
        "paragraph_kgKJ7m": {
          "type": "paragraph",
          "settings": {
            "text": "There are no shortcuts in this process. From the first sketch to the final lace, each step is guided by one principle,build it once, build it right. This is what it means to be Paper Straight."
          }
        },
        "button_FYayAC": {
          "type": "button",
          "settings": {
            "button_text": "Explore The Process",
            "button_link": "shopify://blogs/news/built-with-intent",
            "open_new_tab": false
          }
        }
      },
      "block_order": [
        "paragraph_rm9XdA",
        "paragraph_7tXJz9",
        "paragraph_kgKJ7m",
        "button_FYayAC"
      ],
