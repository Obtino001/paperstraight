{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"color_scheme":"","show_title":true,"page_width":"xs"}},"about_us_purpose_UwB7UG":{"type":"about-us-purpose","blocks":{"paragraph_nkRiYn":{"type":"paragraph","settings":{"text":"Paper Straight is a modern shoe label from Amsterdam, shaped by today’s cultural movements, from hip-hop to design, from street photography to the everyday uniform.\n\nWe build footwear for grownups, pairing bold, considered silhouettes with a clean workwear sensibility. The collection is anchored in derby and hiker DNA, made to last, made to wear.\n\nAlongside the shoes, we design wardrobe essentials that move the same way: oversized denim, grounded layers, and pieces that sharpen or relax the fit depending on the day."}},"subheading_LFfWgT":{"type":"subheading","settings":{"subheading_text":"Where the name comes from"}},"paragraph_DDHCF8":{"type":"paragraph","settings":{"text":"The name Paper Straight is inspired by Brent Faiyaz' track \"Been Away\", a song about the tension between chasing success (\"paper\") and staying true (\"straight\")."}},"paragraph_AfaRY3":{"type":"paragraph","settings":{"text":"It reflects our mindset: build your future, stay grounded, and never lose yourself in the process."}},"button_x7jPqC":{"type":"button","settings":{"button_text":"Learn more","button_link":"#","open_new_tab":false}}},"block_order":["paragraph_nkRiYn","subheading_LFfWgT","paragraph_DDHCF8","paragraph_AfaRY3","button_x7jPqC"],"custom_css":["{margin-top: 40px;}"],"name":"About Us - Purpose","settings":{"subtitle":"ABOUT US","heading":"CRAFTED WITH PURPOSE","image":"shopify:\/\/shop_images\/IMG_1495_5ad87d2b-52e1-4e1c-a570.png","image_alt":"","background_color":"linear-gradient(143deg, rgba(235, 235, 235, 1), rgba(255, 255, 255, 1) 45%)","text_color":"#333333","heading_color":"#000000","subtitle_color":"#666666","button_bg_color":"#1a1a1a","button_text_color":"#ffffff","button_hover_bg":"#333333","button_hover_text":"#ffffff","s