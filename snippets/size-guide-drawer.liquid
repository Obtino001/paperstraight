<script>
document.addEventListener("DOMContentLoaded", () => {
  const drawer = document.getElementById("size-guide-drawer");
  const openBtn = document.querySelector(".js-open-size-guide");
  const overlay = drawer.querySelector(".size-guide-overlay");
  const closeBtns = drawer.querySelectorAll("[data-close]");
  const panel = drawer.querySelector(".size-guide-panel");
  let lastFocused = null;

  const openDrawer = () => {
    lastFocused = document.activeElement;
    drawer.setAttribute("open", "");
    drawer.classList.remove("hide");
    requestAnimationFrame(() => drawer.classList.add("show"));
    document.documentElement.style.overflow = "hidden";
  };

  const closeDrawer = () => {
    drawer.classList.remove("show");
    drawer.classList.add("hide");
    document.documentElement.style.overflow = "";

    // Wait for transition before removing [open]
    setTimeout(() => {
      drawer.removeAttribute("open");
      drawer.classList.remove("hide");
      if (lastFocused) lastFocused.focus();
    }, 500); // must match CSS transition time
  };

  if (openBtn) {
    openBtn.addEventListener("click", openDrawer);
  }
  
  overlay.addEventListener("click", closeDrawer);
  closeBtns.forEach(btn => btn.addEventListener("click", closeDrawer));
  drawer.addEventListener("keydown", e => { if (e.key === "Escape") closeDrawer(); });
});
</script>
