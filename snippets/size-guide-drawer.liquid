<style>
/* Drawer wrapper */
.size-guide-drawer {
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.35s ease;
}
.size-guide-drawer[open] {
  pointer-events: auto;
  opacity: 1;
}

/* Overlay fade */
.size-guide-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.35s ease;
}
.size-guide-drawer[open] .size-guide-overlay {
  opacity: 1;
}

/* Right-side drawer panel */
.size-guide-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 600px;
  max-width: 90%;
  height: 100%;
  background: #fff;
  box-shadow: -8px 0 24px rgba(0, 0, 0, 0.15);
  transform: translateX(100%);
  opacity: 0;
  transition:
    transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.45s ease;
  will-change: transform, opacity;
  overflow-y: auto;
  padding: 28px;
  border-radius: 0;
}

/* When open — slide in */
.size-guide-drawer.show .size-guide-panel {
  transform: translateX(0);
  opacity: 1;
}

/* When closing — smooth slide out */
.size-guide-drawer.hide .size-guide-panel {
  transform: translateX(100%);
  opacity: 0;
}

/* Close button */
.size-guide-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border: none;
  background: #f6f6f6;
  border-radius: 50%;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.3s ease;
}
.size-guide-close:hover {
  background: #eee;
  transform: rotate(90deg);
}

/* Header */
.size-guide-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
  margin-top: 12px;
}
.size-guide-product-img {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
}
.size-guide-header-text h3 {
  margin: 0;
  font-size: 1.15rem;
}
.size-guide-subtitle {
  font-size: 0.9rem;
  color: #777;
  margin: 2px 0 0;
}

/* Body */
.size-guide-body {
  padding-top: 10px;
}
.size-guide-body-img {
  width: 100%;
  border-radius: 10px;
  margin-bottom: 16px;
}
.size-guide-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}
.size-guide-table th,
.size-guide-table td {
  border-bottom: 1px solid #eee;
  padding: 8px;
  text-align: left;
}
.size-guide-table thead th {
  background: #fafafa;
  font-weight: 600;
}

/* Smooth scrollbar */
.size-guide-panel::-webkit-scrollbar {
  width: 6px;
}
.size-guide-panel::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 10px;
}
.size-guide-panel::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

.size-guide-scr.basic {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.size-guide-scr.basic table {
  min-width: 300px;
}

h3.size-guide-title {
  font-size: 20px;
  margin-bottom: 15px;
  line-height: 1.4;
}

.size-guide-desc {
  font-size: 16px;
  line-height: 1.4;
  margin-bottom: 15px;
}

.size-guide-below-desc.size-guide-desc {
  margin-top: 15px;
}

/* Mobile: slide from bottom */
@media (max-width: 640px) {
  .size-guide-panel {
    width: 100%;
    height: 100%;
    bottom: 0;
    top: auto;
    right: 0;
    transform: translateX(100%);
    opacity: 0;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease;
  }
  
  /* When open — slide in */
  .size-guide-drawer.show .size-guide-panel {
    transform: translateX(0);
    opacity: 1;
  }

  /* When closing — smooth slide out */
  .size-guide-drawer.hide .size-guide-panel {
    transform: translateX(100%);
    opacity: 0;
  }
  
  h3.size-guide-title {
    font-size: 18px;
    margin-bottom: 5px;
  }
}
</style>

<!-- Size Guide Drawer -->
