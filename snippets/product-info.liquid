            <style>
              .icon-text-block--{{ block.id }} {
                display: flex;
                align-items: center;
                gap: {{ block.settings.icon_gap }}px;
                margin-bottom: 10px;
                {% if block.settings.background_color != blank and block.settings.background_color != 'rgba(0,0,0,0)' %}
