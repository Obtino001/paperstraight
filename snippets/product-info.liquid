            {%- when 'variant_color' -%}
            <div class="product-info__variant-color" {{ block.shopify_attributes }}>
              <style>
                .variant-color-picker {
                  --swatch-size: {{ block.settings.swatch_size | default: 70 }}px;
                  --swatch-gap: {{ block.settings.swatch_gap | default: 10 }}px;
                  --border-color: {{ block.settings.border_color | default: '#e5e5e5' }};
                  --border-color-active: {{ block.settings.border_color_active | default: '#000000' }};
                  --border-width: {{ block.settings.border_width | default: 1 }}px;
                  --border-width-active: {{ block.settings.border_width_active | default: 2 }}px;
                  --label-color: {{ block.settings.label_color | default: '#000000' }};
                  --label-font-size: {{ block.settings.label_font_size | default: 12 }}px;
                }
                .product-info__variant-color {
                    margin: 10px 0;
                }
                .variant-color-picker__label {
                  font-size: var(--label-font-size);
                  color: var(--label-color);
                  margin-bottom: 10px;
                  font-weight: 400;
                  letter-spacing: 0.5px;
                  text-transform: uppercase;
                }
                .variant-color-picker__label span {
                  font-weight: 600;
                }
                .variant-color-picker__swatches {
                  display: flex;
                  flex-wrap: wrap;
                  gap: var(--swatch-gap);
                }
                .variant-color-picker__swatch {
                  width: 53px;
                  height: var(--swatch-size);
                  border: var(--border-width) solid var(--border-color);
                  cursor: pointer;
                  transition: border-color 0.2s ease;
                  overflow: hidden;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  background-color: #fff;
                  box-sizing: border-box;
                }
                .variant-color-picker__swatch:hover,
                .variant-color-picker__swatch.is-active {
                  border-width: var(--border-width-active);
                  border-color: var(--border-color-active);
                }
                .variant-color-picker__swatch img {
                  width: 100%;
                  height: 100%;
                  object-fit: contain;
                }
                .variant-color-picker__swatch a {
                  display: block;
                  width: 100%;
                  height: 100%;
                }
                @media screen and (max-width: 749px) {
                  .variant-color-picker {
                    --swatch-size: {{ block.settings.swatch_size_mobile | default: 60 }}px;
                    --swatch-gap: {{ block.settings.swatch_gap_mobile | default: 8 }}px;
                  }
                  .variant-color-picker__label {
                    font-size: {{ block.settings.label_font_size_mobile | default: 11 }}px;
                  }
                }
              </style>

              <div class="variant-color-picker">
                {% comment %} Get current product color {% endcomment %}
                {% assign current_color = '' %}
                {% for option in product.options_with_values %}
                  {% assign option_name_downcase = option.name | downcase %}
                  {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                    {% assign current_color = product.selected_or_first_available_variant.options[forloop.index0] %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% if block.settings.show_label and block.settings.product_list != blank %}
                  <div class="variant-color-picker__label">
                    {{ block.settings.label_text | default: 'COLOR' }} : <span>{{ current_color | upcase }}</span>
                  </div>
                {% endif %}

                <div class="variant-color-picker__swatches">
                  {% for item in block.settings.product_list %}
                    {% comment %} Get color name for this product {% endcomment %}
                    {% assign item_color = item.title %}
                    {% for option in item.options_with_values %}
                      {% assign option_name_downcase = option.name | downcase %}
                      {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                        {% assign item_color = item.selected_or_first_available_variant.options[forloop.index0] %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% assign is_current = false %}
                    {% if item.id == product.id %}
                      {% assign is_current = true %}
                    {% endif %}

                    <div class="variant-color-picker__swatch{% if is_current %} is-active{% endif %}" 
                        data-color="{{ item_color }}"
                        data-product-url="{{ item.url }}">
                      <a href="{{ item.url }}" title="{{ item_color }}">
                        {% if item.featured_image != blank %}
                          <img src="{{ item.featured_image | image_url: width: 150 }}"
                              alt="{{ item_color }}"
                              loading="lazy"
                              width="150"
                              height="150">
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}
                      </a>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <script>
                (function() {
                  const container = document.querySelector('.variant-color-picker');
                  if (!container) return;
                  
                  const swatches = container.querySelectorAll('.variant-color-picker__swatch');
                  const label = container.querySelector('.variant-color-picker__label span');
                  
                  swatches.forEach(swatch => {
                    swatch.addEventListener('mouseenter', function() {
                      if (label) {
                        label.textContent = this.dataset.color.toUpperCase();
                      }
                    });
                    
                    swatch.addEventListener('mouseleave', function() {
                      if (label) {
                        const activeSwatch = container.querySelector('.variant-color-picker__swatch.is-active');
                        if (activeSwatch) {
                          label.textContent = activeSwatch.dataset.color.toUpperCase();
                        }
                      }
                    });
                  });
                })();
              </script>
            </div>


