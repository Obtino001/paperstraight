{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT INFO
----------------------------------------------------------------------------------------------------------------------

This snippet renders all the blocks of a given product. It uses the blocks of the section currently in use (there is
no need to manually pass the section as it is globally available)

********************************************
Supported variables
********************************************

* product: the product on which to render the information (if blank, it renders placeholder information)
* product_form_id: the ID of the product form
* center_basic_info: if true, the basic information (product title, vendor, price) are centered on mobile
* has_content_below_gallery: if true, the product has extra information show below the gallery
* context: the context of the product info. Can be "main_product", "featured_product" or "quick_buy"
{%- endcomment -%}

<safe-sticky class="product-info {% if center_basic_info %}product-info--center{% endif %}">
  <div class="product-info__block-list">
    {%- liquid
      assign inside_block_group_context = false
      assign current_block_group_name = ''

      if context == 'quick_buy'
        assign allow_blocks = '@app vendor title price quantity_selector payment_terms separator variant_picker product_variations line_item_property buy_buttons' | split: ' '
      endif

      if allow_blocks != blank
        assign filtered_blocks = '' | split: ''

        for block in section.blocks
          if allow_blocks contains block.type
            assign block_as_arr = block | sort
            assign filtered_blocks = filtered_blocks | concat: block_as_arr
          endif
        endfor
      else
        assign filtered_blocks = section.blocks
      endif
    -%}

    {%- for block in filtered_blocks -%}
      {%- liquid
        # Filter the blocks (if allow_blocks is set)
        if allow_blocks
          unless allow_blocks contains block.type
            continue
          endunless
        endif

        assign next_block_index = forloop.index0 | plus: 1
        assign next_block = filtered_blocks[next_block_index]

        if block.settings.show_below_gallery
          continue
        endif

        comment
        You can use your own condition to create smart grouping. When two or more blocks match the condition, they are
        automatically grouped by a div that will take the desired class. This can even work for more than 2 elements
        (for instance if you specify accordion follow by an accordion). The theme takes care of properly opening and
        closing the group for proper HTML. In order to make it work, you need to create one condition explaining when
        to enter into the group, and you need to indicate a block_group_class and block_group_name. Most of the time,
        the two will be identical. However, the block_group_name must be unique. This means that as long as the block_group_name
        stays the same, then another group will not be created as long as the conditions match.
        endcomment

        assign allow_block_group = true

        if block.type == 'price' and block.settings.show_taxes_notice == false and next_block.type == 'rating'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'rating' and next_block.type == 'price' and next_block.settings.show_taxes_notice == false
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'sku' and next_block.type == 'rating'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'rating' and next_block.type == 'sku'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'accordion' and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'accordion' and next_block.type == 'description' and product.description != blank and next_block.settings.collapse_content and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'description' and product.description != blank and block.settings.collapse_content and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'feature_with_icon' and next_block.type == 'feature_with_icon'
          assign block_group_class = 'feature-badge-list'
          assign block_group_name = 'feature-badge-list'
        else
          assign allow_block_group = false
          assign block_group_class = ''
          assign current_block_group_name = ''
        endif

        if allow_block_group
          assign new_block_group_name = block_group_name

          if inside_block_group_context == true and new_block_group_name != current_block_group_name
            assign allow_block_group = false
          else
            assign current_block_group_name = new_block_group_name
          endif
        endif
      -%}

      {%- capture block_content -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}

          {%- when 'vendor' -%}
            {%- if product != blank -%}
              {%- render 'vendor' with product.vendor, class: 'h6 link-faded' -%}
            {%- else -%}
              {%- assign placeholder_vendor = 'general.on_boarding.product_vendor' | t -%}
              {%- render 'vendor' with placeholder_vendor, class: 'h6 link-faded' -%}
            {%- endif -%}

          {%- when 'title' -%}
            {%- if product != blank -%}
              {%- assign product_title = product.title -%}
            {%- else -%}
              {%- assign product_title = 'general.on_boarding.product_title' | t -%}
            {%- endif -%}

            {%- if request.page_type == 'product' and context == 'main_product' -%}
              <h1 class="product-title {{ block.settings.heading_tag }}">
                {{- product_title -}}
              </h1>
            {%- else -%}
              <h2 class="product-title {{ block.settings.heading_tag }}">
                <a href="{{ product.url }}">{{ product_title }}</a>
              </h2>
            {%- endif -%}
             {%- when 'multi-icon' -%}
                {% render 'multi-icon' block: block %}
            {% when 'upsell_products' %}
           {% render 'product-addons',product:product,block:block %}

            {%- when 'product_videos' -%}
              <div class="video-slider-section-{{ block.id }}">
                
                <div class="video-slider-container">
                  {% if block.settings.heading != blank %}
                  <div class="video-section-heading">
                    {{ block.settings.heading }}
                  </div>
                  {% endif %}

                  <!-- Prev Arrow - Left Side (hidden by default) -->
                  <button class="slide-prev-btn" id="slidePrev-{{ block.id }}" aria-label="Previous" style="display: none;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M15 18l-6-6 6-6"/>
                    </svg>
                  </button>
                  
                  <div class="video-slider-track" id="videoSlider-{{ block.id }}">
                    {% for i in (1..10) %}
                      {% assign video_key = 'video' | append: i %}
                      {% assign label_key = 'label' | append: i %}
                      {% assign video = block.settings[video_key] %}
                      {% assign label = block.settings[label_key] %}

                      {% if video != blank %}
                        <div class="video-slide-item">
                          <div
                            class="video-thumbnail"
                            data-index="{{ forloop.index0 }}"
                            data-group="{{ block.id }}"
                            data-video-url="{{ video }}"
                          >
                            <video
                              src="{{ video }}"
                              muted
                              loop
                              autoplay
                              playsinline
                              preload="metadata"
                            ></video>
                            <div class="play-button">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z"/>
                              </svg>
                            </div>
                          </div>
                          {% if label %}
                            <div class="video-title">{{ label }}</div>
                          {% endif %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  <!-- Next Arrow - Right Side -->
                  <button class="slide-next-btn" id="slideNext-{{ block.id }}" aria-label="Next">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M9 18l6-6-6-6"/>
                    </svg>
                  </button>
                </div>
              </div>

              <style>
                /* Main Section Container */
                .video-slider-section-{{ block.id }} {
                  width: 100%;
                  background: rgba(245, 245, 245, 1);
                  margin: 20px 0;
                }

                /* Heading */
                .video-slider-section-{{ block.id }} .video-section-heading {
                  padding: 16px 0px 10px;
                  font-size: 12px;
                  font-weight: 400;
                  color: #000;
                  letter-spacing: 0.3px;
                }

                /* Slider Container */
                .video-slider-section-{{ block.id }} .video-slider-container {
                  position: relative;
                  padding: 0 16px 16px;
                }

                /* Slider Track */
                .video-slider-section-{{ block.id }} .video-slider-track {
                  display: flex;
                  gap: 6px;
                  overflow-x: auto;
                  scroll-behavior: smooth;
                  scrollbar-width: none;
                  -ms-overflow-style: none;
                }
                

                .video-slider-section-{{ block.id }} .video-slider-track::-webkit-scrollbar {
                  display: none;
                }
                @media (min-width: 1024px) {
                    .video-slider-section-{{ block.id }} {
                        flex: 0 0 calc((100% / 4) - ((6px + 3.0px) / 3));
                    }
                }

                /* Video Slide Item */
                .video-slider-section-{{ block.id }} .video-slide-item {
                  flex: 0 0 calc((100% / 4) - ((6px + 3.0px) / 3));
                  width: 100%;
                }
                

                /* Video Thumbnail */
                .video-slider-section-{{ block.id }} .video-thumbnail {
                  position: relative;
                  width: 100%;
                  height: auto;
                  border-radius: 0px;
                  overflow: hidden;
                  cursor: pointer;
                  aspect-ratio: 9.6 / 16;
                }

                .video-slider-section-{{ block.id }} .video-thumbnail video {
                  width: 100%;
                  height: 100%;
                  object-fit: cover;
                  display: block;
                }

                /* Play Button */
                .video-slider-section-{{ block.id }} .play-button {
                  position: absolute;
                  top: 50%;
                  left: 50%;
                  transform: translate(-50%, -50%);
                  width: 35px;
                  height: 35px;
                  background: rgba(255, 255, 255, 0.92);
                  border-radius: 50%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #333;
                  pointer-events: none;
                  transition: transform 0.2s ease;
                }

                .video-slider-section-{{ block.id }} .video-thumbnail:hover .play-button {
                  transform: translate(-50%, -50%) scale(1.08);
                }

                /* Video Title */
                .video-slider-section-{{ block.id }} .video-title {
                  margin-top: 8px;
                  font-size: 12px;
                  font-weight: 500;
                  color: #333;
                  text-align: center;
                  line-height: 1.3;
                }

                /* Prev Button */
                .video-slider-section-{{ block.id }} .slide-prev-btn {
                  position: absolute;
                  left: 8px;
                  top: 55%;
                  transform: translateY(-70%);
                  width: 35px;
                  height: 52.5px;
                  background: rgba(255,255,255,0.7);
                  border: none;
                  border-radius: 0 8px 8px 0;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #000;
                  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
                  z-index: 10;
                  transition: all 0.2s ease;
                }

                .video-slider-section-{{ block.id }} .slide-prev-btn:hover {
                  background: #000;
                  color: #fff;
                }

                /* Next Button */
                .video-slider-section-{{ block.id }} .slide-next-btn {
                  position: absolute;
                  right: 8px;
                  top: 55%;
                  transform: translateY(-70%);
                  width: 35px;
                  height: 52.5px;
                  background: rgba(255,255,255,0.7);
                  border: none;
                  border-radius: 8px 0 0 8px;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #000;
                  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
                  z-index: 10;
                  transition: all 0.2s ease;
                }

                .video-slider-section-{{ block.id }} .slide-next-btn:hover {
                  background: #000;
                  color: #fff;
                }

                /* =============================================
                  VIDEO MODAL STYLES - GLOBAL
                  ============================================= */
                .video-modal-fullscreen {
                  position: fixed !important;
                  top: 0 !important;
                  left: 0 !important;
                  width: 100vw !important;
                  height: 100vh !important;
                  background: rgba(0, 0, 0, 0.5) !important;
                  z-index: 2147483647 !important; /* Maximum z-index */
                  display: none;
                  justify-content: center;
                  align-items: center;
                  margin: 0 !important;
                  padding: 0 !important;
                  border: none !important;
                  transform: none !important;
                }

                .video-modal-fullscreen.active {
                  display: flex !important;
                }

                /* Close Button */
                .video-modal-fullscreen .modal-close-btn {
                  position: fixed !important;
                  top: 20px !important;
                  right: 20px !important;
                  width: 44px;
                  height: 44px;
                  background: rgba(255, 255, 255, 0.15);
                  border: none;
                  border-radius: 8px;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #fff;
                  z-index: 2147483647 !important;
                  transition: opacity 0.2s ease;
                }

                .video-modal-fullscreen .modal-close-btn:hover {
                  opacity: 0.7;
                }

                /* Sound Button */
                .video-modal-fullscreen .modal-sound-btn {
                  position: fixed !important;
                  top: 20px !important;
                  left: 20px !important;
                  width: 44px;
                  height: 44px;
                  background: rgba(255, 255, 255, 0.15);
                  border: none;
                  border-radius: 50%;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #fff;
                  z-index: 2147483647 !important;
                  transition: background 0.2s ease;
                }

                .video-modal-fullscreen .modal-sound-btn:hover {
                  background: rgba(255, 255, 255, 0.25);
                }

                .video-modal-fullscreen .modal-sound-btn .icon-sound-off {
                  display: none;
                }

                .video-modal-fullscreen .modal-sound-btn.muted .icon-sound-on {
                  display: none;
                }

                .video-modal-fullscreen .modal-sound-btn.muted .icon-sound-off {
                  display: block;
                }

                /* Video Wrapper */
                .video-modal-fullscreen .modal-video-wrapper {
                  position: relative;
                  width: 100%;
                  max-width: 420px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                }

                .video-modal-fullscreen .modal-video-wrapper video {
                  width: 100%;
                  max-height: 85vh;
                  object-fit: contain;
                  border-radius: 10px;
                  background: #000;
                }

                /* Navigation Buttons */
                .video-modal-fullscreen .modal-nav-btn {
                  position: fixed !important;
                  top: 50% !important;
                  transform: translateY(-50%) !important;
                  width: 50px;
                  height: 50px;
                  background: rgb(93 93 99);
                  border: none;
                  border-radius: 8px;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #fff;
                  transition: all 0.2s ease;
                  z-index: 2147483647 !important;
                }

                .video-modal-fullscreen .modal-nav-btn:hover {
                  background: rgb(93 93 99);
                }

                .video-modal-fullscreen .modal-prev {
                  left: 20px !important;
                }

                .video-modal-fullscreen .modal-next {
                  right: 20px !important;
                }

                /* Mobile Responsive */
                @media (max-width: 767px) {
                  .video-slider-section-{{ block.id }} .video-section-heading {
                    padding: 14px 0px 10px;
                  }
                  .video-slider-section-{{ block.id }} .video-slider-container {
                    padding: 0 6px 14px;
                  }
                  .video-slider-section-{{ block.id }} .video-slider-track {
                    gap: 6px;
                  }
                  .video-slider-section-{{ block.id }} .video-slide-item {
                    flex: 0 0 calc((100% / 4) - ((6px + 3.0px) / 3));
                    width: 100%;
                    display: block;
                    box-sizing: border-box !important;
                    height: auto !important;
                    overflow: hidden;
                    position: relative;
                    cursor: pointer;
                  }
                  .video-slider-section-{{ block.id }} .video-thumbnail {
                    aspect-ratio: 9.6 / 16;
                  }
                  .video-slider-section-{{ block.id }} .play-button {
                    width: 30px;
                    height: 30px;
                  }
                  .video-slider-section-{{ block.id }} .play-button svg {
                    width: 22px;
                    height: 22px;
                  }
                  .video-slider-section-{{ block.id }} .slide-prev-btn {
                    width: 30px;
                    height: 45px;
                    left: 6px;
                    border-radius: 0 5px 5px 0;
                  }
                  .video-slider-section-{{ block.id }} .slide-prev-btn svg {
                    width: 22px;
                    height: 22px;
                  }
                  .video-slider-section-{{ block.id }} .slide-next-btn {
                    width: 30px;
                    height: 45px;
                    right: 6px;
                    border-radius: 5px 0 0 5px;
                  }
                  .video-slider-section-{{ block.id }} .slide-next-btn svg {
                    width: 22px;
                    height: 22px;
                  }

                  /* Modal Mobile */
                  .video-modal-fullscreen .modal-video-wrapper {
                    max-width: 90%;
                  }

                  .video-modal-fullscreen .modal-close-btn,
                  .video-modal-fullscreen .modal-sound-btn {
                    width: 40px;
                    height: 40px;
                    top: 15px !important;
                  }

                  .video-modal-fullscreen .modal-close-btn {
                    right: 15px !important;
                  }

                  .video-modal-fullscreen .modal-sound-btn {
                    left: 15px !important;
                  }

                  .video-modal-fullscreen .modal-nav-btn {
                    width: 44px;
                    height: 44px;
                  }

                  .video-modal-fullscreen .modal-prev {
                    left: 10px !important;
                  }

                  .video-modal-fullscreen .modal-next {
                    right: 10px !important;
                  }
                }
              </style>

              <script>
                (function() {
                  const blockId = '{{ block.id }}';
                  
                  document.addEventListener('DOMContentLoaded', function() {
                    const slider = document.getElementById('videoSlider-' + blockId);
                    const nextBtn = document.getElementById('slideNext-' + blockId);
                    const prevBtn = document.getElementById('slidePrev-' + blockId);
                    
                    let allThumbnails = [];
                    let currentIndex = 0;

                    // Function to get modal elements (ensures we always get fresh references)
                    function getModalElements() {
                      const modal = document.getElementById('videoModalFullscreen-' + blockId);
                      if (!modal) return null;
                      return {
                        modal: modal,
                        modalVideo: document.getElementById('modalVideoFullscreen-' + blockId),
                        soundBtn: document.getElementById('soundBtnFullscreen-' + blockId),
                        closeBtn: modal.querySelector('.modal-close-btn'),
                        prevNav: modal.querySelector('.modal-prev'),
                        nextNav: modal.querySelector('.modal-next')
                      };
                    }

                    // Function to check scroll position and update button visibility
                    function updateNavigationButtons() {
                      if (!slider) return;
                      
                      const scrollLeft = slider.scrollLeft;
                      const maxScrollLeft = slider.scrollWidth - slider.clientWidth;
                      
                      if (scrollLeft > 5) {
                        prevBtn.style.display = 'flex';
                      } else {
                        prevBtn.style.display = 'none';
                      }
                      
                      if (scrollLeft >= maxScrollLeft - 5) {
                        nextBtn.style.display = 'none';
                      } else {
                        nextBtn.style.display = 'flex';
                      }
                    }

                    updateNavigationButtons();

                    if (slider) {
                      slider.addEventListener('scroll', updateNavigationButtons);
                      window.addEventListener('resize', updateNavigationButtons);
                    }

                    // Create modal and append to body
                    function createModal() {
                      if (document.getElementById('videoModalFullscreen-' + blockId)) {
                        return;
                      }

                      const modalHTML = `
                        <div class="video-modal-fullscreen" id="videoModalFullscreen-${blockId}">
                          <button class="modal-close-btn" aria-label="Close">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M18 6L6 18M6 6l12 12"/>
                            </svg>
                          </button>

                          <button class="modal-sound-btn muted" id="soundBtnFullscreen-${blockId}" aria-label="Toggle Sound">
                            <svg class="icon-sound-on" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                            </svg>
                            <svg class="icon-sound-off" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                            </svg>
                          </button>

                          <button class="modal-nav-btn modal-prev" aria-label="Previous">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M15 18l-6-6 6-6"/>
                            </svg>
                          </button>

                          <div class="modal-video-wrapper">
                            <video id="modalVideoFullscreen-${blockId}" playsinline autoplay loop></video>
                          </div>

                          <button class="modal-nav-btn modal-next" aria-label="Next">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M9 18l6-6-6-6"/>
                            </svg>
                          </button>
                        </div>
                      `;

                      document.body.insertAdjacentHTML('beforeend', modalHTML);

                      const elements = getModalElements();
                      if (!elements) return;

                      elements.closeBtn.addEventListener('click', closeModal);
                      elements.soundBtn.addEventListener('click', toggleSound);
                      elements.prevNav.addEventListener('click', function() { goToVideo('prev'); });
                      elements.nextNav.addEventListener('click', function() { goToVideo('next'); });

                      elements.modal.addEventListener('click', function(e) {
                        if (e.target === elements.modal) {
                          closeModal();
                        }
                      });
                    }

                    // Slider Next Button
                    if (nextBtn && slider) {
                      nextBtn.addEventListener('click', function() {
                        const slideItem = slider.querySelector('.video-slide-item');
                        if (slideItem) {
                          const slideWidth = slideItem.offsetWidth + 6;
                          slider.scrollBy({ left: slideWidth * 2, behavior: 'smooth' });
                        }
                      });
                    }

                    // Slider Prev Button
                    if (prevBtn && slider) {
                      prevBtn.addEventListener('click', function() {
                        const slideItem = slider.querySelector('.video-slide-item');
                        if (slideItem) {
                          const slideWidth = slideItem.offsetWidth + 6;
                          slider.scrollBy({ left: -(slideWidth * 2), behavior: 'smooth' });
                        }
                      });
                    }

                    // Video Thumbnail Clicks
                    const thumbnails = document.querySelectorAll('.video-slider-section-' + blockId + ' .video-thumbnail');
                    allThumbnails = Array.from(thumbnails);
                    
                    thumbnails.forEach(function(thumb, idx) {
                      thumb.addEventListener('click', function() {
                        currentIndex = idx;
                        openModal();
                      });
                    });

                    // Open Modal
                    function openModal() {
                      createModal();
                      const elements = getModalElements();
                      if (!elements) return;
                      
                      const videoUrl = allThumbnails[currentIndex].getAttribute('data-video-url');
                      elements.modalVideo.src = videoUrl;
                      elements.modalVideo.muted = true;
                      elements.soundBtn.classList.add('muted');
                      elements.modal.classList.add('active');
                      elements.modalVideo.play();
                      document.body.style.overflow = 'hidden';
                      document.documentElement.style.overflow = 'hidden';
                    }

                    // Close Modal
                    function closeModal() {
                      const elements = getModalElements();
                      if (!elements) return;
                      
                      elements.modal.classList.remove('active');
                      elements.modalVideo.pause();
                      elements.modalVideo.src = '';
                      document.body.style.overflow = '';
                      document.documentElement.style.overflow = '';
                    }

                    // Navigate Videos
                    function goToVideo(direction) {
                      const elements = getModalElements();
                      if (!elements) return;
                      
                      if (direction === 'next') {
                        currentIndex = (currentIndex + 1) % allThumbnails.length;
                      } else {
                        currentIndex = (currentIndex - 1 + allThumbnails.length) % allThumbnails.length;
                      }
                      const videoUrl = allThumbnails[currentIndex].getAttribute('data-video-url');
                      const wasMuted = elements.modalVideo.muted;
                      elements.modalVideo.src = videoUrl;
                      elements.modalVideo.muted = wasMuted;
                      elements.modalVideo.play();
                    }

                    // Toggle Sound
                    function toggleSound() {
                      const elements = getModalElements();
                      if (!elements) return;
                      
                      elements.modalVideo.muted = !elements.modalVideo.muted;
                      if (elements.modalVideo.muted) {
                        elements.soundBtn.classList.add('muted');
                      } else {
                        elements.soundBtn.classList.remove('muted');
                      }
                    }

                    // Keyboard controls - scoped to THIS block's modal only
                    document.addEventListener('keydown', function(e) {
                      const elements = getModalElements();
                      if (!elements || !elements.modal.classList.contains('active')) return;
                      
                      if (e.key === 'Escape') {
                        closeModal();
                      } else if (e.key === 'ArrowRight') {
                        goToVideo('next');
                      } else if (e.key === 'ArrowLeft') {
                        goToVideo('prev');
                      }
                    });
                  });
                })();
                </script>


