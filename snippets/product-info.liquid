          {%- when 'shipping-cutoff-block' -%}
            {%- liquid
              assign now = 'now' | date: '%s' | plus: 0
              assign current_hour = 'now' | date: '%H' | plus: 0
              assign current_minute = 'now' | date: '%M' | plus: 0
              assign current_time_minutes = current_hour | times: 60 | plus: current_minute
              
              assign cutoff_hour = block.settings.cutoff_hour
              assign cutoff_minute = block.settings.cutoff_minute
              assign cutoff_time_minutes = cutoff_hour | times: 60 | plus: cutoff_minute
              
              assign days_to_add = block.settings.processing_days
              assign exclude_weekends = block.settings.exclude_weekends
              
              if current_time_minutes < cutoff_time_minutes
                assign is_before_cutoff = true
              else
                assign is_before_cutoff = false
                assign days_to_add = days_to_add | plus: 1
              endif
              
              assign current_day_of_week = 'now' | date: '%w' | plus: 0
              
              if exclude_weekends
                if current_day_of_week == 6
                  assign days_to_add = days_to_add | plus: 2
                elsif current_day_of_week == 0
                  assign days_to_add = days_to_add | plus: 1
                endif
              endif
              
              assign seconds_to_add = days_to_add | times: 86400
              assign ship_date_timestamp = now | plus: seconds_to_add
              
              assign ship_day_of_week = ship_date_timestamp | date: '%w' | plus: 0
              if exclude_weekends
                if ship_day_of_week == 6
                  assign ship_date_timestamp = ship_date_timestamp | plus: 172800
                elsif ship_day_of_week == 0
                  assign ship_date_timestamp = ship_date_timestamp | plus: 86400
                endif
              endif
              
              case block.settings.date_format
                when 'full'
                  assign formatted_date = ship_date_timestamp | date: '%B %d'
                when 'short'
                  assign formatted_date = ship_date_timestamp | date: '%b %d'
                when 'numeric'
                  assign formatted_date = ship_date_timestamp | date: '%m/%d'
                when 'day_name'
                  assign formatted_date = ship_date_timestamp | date: '%A, %B %d'
                when 'relative'
                  assign formatted_date = ship_date_timestamp | date: '%A'
              endcase
              
              if block.settings.cutoff_minute < 10
                assign display_minute = cutoff_minute | prepend: '0'
              else
                assign display_minute = cutoff_minute
              endif
              
              if block.settings.time_format == '12h'
                if cutoff_hour == 0
                  assign display_hour = 12
                  assign am_pm = 'AM'
                elsif cutoff_hour < 12
                  assign display_hour = cutoff_hour
                  assign am_pm = 'AM'
                elsif cutoff_hour == 12
                  assign display_hour = 12
                  assign am_pm = 'PM'
                else
                  assign display_hour = cutoff_hour | minus: 12
                  assign am_pm = 'PM'
                endif
                assign display_time = display_hour | append: ':' | append: display_minute | append: ' ' | append: am_pm
              else
                if cutoff_hour < 10
                  assign display_hour = cutoff_hour | prepend: '0'
                else
                  assign display_hour = cutoff_hour
                endif
                assign display_time = display_hour | append: ':' | append: display_minute
              endif
              
              assign text_before = block.settings.text_before_cutoff
              assign text_after = block.settings.text_after_cutoff
              assign text_before_display = text_before | replace: '[time]', display_time | replace: '[date]', formatted_date
              assign text_after_display = text_after | replace: '[time]', display_time | replace: '[date]', formatted_date
            -%}

            <div class="shipping-cutoff-block shipping-cutoff-block--{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="shipping-cutoff-block__icon">
                  <img
                    src="{{ block.settings.icon | img_url }}"
                    alt="{{ block.settings.icon.alt | default: 'Shipping' | escape }}"
                    width="{{ block.settings.icon_size }}"
                    height="{{ block.settings.icon_size }}"
                    loading="lazy"
                  >
                </div>
              {%- elsif block.settings.show_default_icon -%}
                <div class="shipping-cutoff-block__icon shipping-cutoff-block__icon--svg">
                  <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 576 512" fill="{{ block.settings.icon_color }}" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 32C0 14.3 14.3 0 32 0h72.9c27.5 0 52 17.6 60.7 43.8L257.7 320c30.1 .5 56.8 14.9 74 37l202.1-67.4c16.8-5.6 34.9 3.5 40.5 20.2s-3.5 34.9-20.2 40.5L352 417.7c-.9 52.2-43.5 94.3-96 94.3c-53 0-96-43-96-96c0-30.8 14.5-58.2 37-75.8L104.9 64H32C14.3 64 0 49.7 0 32zM244.8 134.5c-5.5-16.8 3.7-34.9 20.5-40.3L311 79.4l19.8 60.9 60.9-19.8L371.8 59.6l45.7-14.8c16.8-5.5 34.9 3.7 40.3 20.5l49.4 152.2c5.5 16.8-3.7 34.9-20.5 40.3L334.5 307.2c-16.8 5.5-34.9-3.7-40.3-20.5L244.8 134.5z"/>
                  </svg>
                </div>
              {%- endif -%}

              <div class="shipping-cutoff-block__content">
                <p class="shipping-cutoff-block__text"
                  data-cutoff-hour="{{ cutoff_hour }}" 
                  data-cutoff-minute="{{ cutoff_minute }}" 
                  data-processing-days="{{ block.settings.processing_days }}" 
                  data-exclude-weekends="{{ exclude_weekends }}" 
                  data-date-format="{{ block.settings.date_format }}" 
                  data-time-format="{{ block.settings.time_format }}">
                  {%- if is_before_cutoff -%}
                    {{ text_before_display }}
                  {%- else -%}
                    {{ text_after_display }}
                  {%- endif -%}
                </p>
                
                {%- if block.settings.show_countdown and is_before_cutoff -%}
                  <div class="shipping-cutoff-block__countdown" data-cutoff-hour="{{ cutoff_hour }}" data-cutoff-minute="{{ cutoff_minute }}">
                    <span class="countdown-label">{{ block.settings.countdown_label }}</span>
                    <span class="countdown-timer">
                      <span class="countdown-hours">00</span>:<span class="countdown-minutes">00</span>:<span class="countdown-seconds">00</span>
                    </span>
                  </div>
                {%- endif -%}
              </div>
            </div>

            <style>
              .shipping-cutoff-block--{{ block.id }} {
                display: flex;
                align-items: center;
                gap: {{ block.settings.icon_gap }}px;
                margin-bottom: 10px;
                {% if block.settings.background_color != blank and block.settings.background_color != 'rgba(0,0,0,0)' %}
                  background-color: {{ block.settings.background_color }};
                  padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                  border-radius: {{ block.settings.border_radius }}px;
                {% endif %}
              }

              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
              }

              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__icon img,
              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__icon svg {
                width: {{ block.settings.icon_size }}px;
                height: {{ block.settings.icon_size }}px;
                object-fit: contain;
              }

              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__content {
                display: flex;
                flex-direction: column;
                gap: 4px;
              }

              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__text {
                margin: 0;
                font-size: {{ block.settings.font_size_desktop }}px;
                line-height: {{ block.settings.line_height }};
                color: {{ block.settings.text_color }};
                font-weight: {{ block.settings.font_weight }};
              }

              .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__countdown {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: {{ block.settings.countdown_font_size }}px;
                color: {{ block.settings.countdown_color }};
              }

              .shipping-cutoff-block--{{ block.id }} .countdown-timer {
                font-weight: 600;
                font-variant-numeric: tabular-nums;
              }

              @media screen and (max-width: 749px) {
                .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__text {
                  font-size: {{ block.settings.font_size_mobile }}px;
                }

                .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__icon img,
                .shipping-cutoff-block--{{ block.id }} .shipping-cutoff-block__icon svg {
                  width: {{ block.settings.icon_size_mobile }}px;
                  height: {{ block.settings.icon_size_mobile }}px;
                }
              }
            </style>

            <script>
              (function() {
                const block = document.querySelector('.shipping-cutoff-block--{{ block.id }}');
                if (!block) return;

                const textEl = block.querySelector('.shipping-cutoff-block__text');
                const countdownEl = block.querySelector('.shipping-cutoff-block__countdown');
                
                if (!textEl) return;

                const cutoffHour = parseInt(textEl.dataset.cutoffHour, 10);
                const cutoffMinute = parseInt(textEl.dataset.cutoffMinute, 10);
                const processingDays = parseInt(textEl.dataset.processingDays, 10);
                const excludeWeekends = textEl.dataset.excludeWeekends === 'true';
                const dateFormat = textEl.dataset.dateFormat;
                const timeFormat = textEl.dataset.timeFormat;
                
                const textBefore = {{ block.settings.text_before_cutoff | json }};
                const textAfter = {{ block.settings.text_after_cutoff | json }};

                function formatTime(hour, minute) {
                  const displayMinute = minute.toString().padStart(2, '0');
                  if (timeFormat === '12h') {
                    let displayHour, amPm;
                    if (hour === 0) { displayHour = 12; amPm = 'AM'; }
                    else if (hour < 12) { displayHour = hour; amPm = 'AM'; }
                    else if (hour === 12) { displayHour = 12; amPm = 'PM'; }
                    else { displayHour = hour - 12; amPm = 'PM'; }
                    return `${displayHour}:${displayMinute} ${amPm}`;
                  }
                  return `${hour.toString().padStart(2, '0')}:${displayMinute}`;
                }

                function formatDate(date) {
                  const locale = document.documentElement.lang || (window.Shopify && window.Shopify.locale) || 'en';
                  
                  switch (dateFormat) {
                    case 'full': 
                      return new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric' }).format(date);
                    case 'short': 
                      return new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric' }).format(date);
                    case 'numeric': 
                      return new Intl.DateTimeFormat(locale, { month: '2-digit', day: '2-digit' }).format(date);
                    case 'day_name': 
                      return new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric' }).format(date);
                    case 'relative': 
                      return new Intl.DateTimeFormat(locale, { weekday: 'long' }).format(date);
                    default: 
                      return new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric' }).format(date);
                  }
                }

                function getShipDate(isBeforeCutoff) {
                  const now = new Date();
                  let daysToAdd = processingDays;
                  
                  if (!isBeforeCutoff) daysToAdd++;
                  
                  if (excludeWeekends) {
                    const dayOfWeek = now.getDay();
                    if (dayOfWeek === 6) daysToAdd += 2;
                    else if (dayOfWeek === 0) daysToAdd += 1;
                  }
                  
                  const shipDate = new Date(now.getTime() + daysToAdd * 86400000);
                  
                  if (excludeWeekends) {
                    const shipDayOfWeek = shipDate.getDay();
                    if (shipDayOfWeek === 6) shipDate.setDate(shipDate.getDate() + 2);
                    else if (shipDayOfWeek === 0) shipDate.setDate(shipDate.getDate() + 1);
                  }
                  
                  return shipDate;
                }

                function updateDisplay() {
                  const now = new Date();
                  const currentMinutes = now.getHours() * 60 + now.getMinutes();
                  const cutoffMinutes = cutoffHour * 60 + cutoffMinute;
                  const isBeforeCutoff = currentMinutes < cutoffMinutes;
                  
                  const shipDate = getShipDate(isBeforeCutoff);
                  const formattedDate = formatDate(shipDate);
                  const formattedTime = formatTime(cutoffHour, cutoffMinute);
                  
                  let text = isBeforeCutoff ? textBefore : textAfter;
                  text = text.replace('[time]', formattedTime).replace('[date]', formattedDate);
                  textEl.textContent = text;
                  
                  if (countdownEl) {
                    if (isBeforeCutoff) {
                      countdownEl.style.display = '';
                      const cutoffToday = new Date(now);
                      cutoffToday.setHours(cutoffHour, cutoffMinute, 0, 0);
                      const diff = cutoffToday - now;
                      
                      if (diff > 0) {
                        const hours = Math.floor(diff / 3600000);
                        const minutes = Math.floor((diff % 3600000) / 60000);
                        const seconds = Math.floor((diff % 60000) / 1000);
                        
                        countdownEl.querySelector('.countdown-hours').textContent = hours.toString().padStart(2, '0');
                        countdownEl.querySelector('.countdown-minutes').textContent = minutes.toString().padStart(2, '0');
                        countdownEl.querySelector('.countdown-seconds').textContent = seconds.toString().padStart(2, '0');
                      }
                    } else {
                      countdownEl.style.display = 'none';
                    }
                  }
                }

                updateDisplay();
                // Only tick when tab is visible to save CPU/repaints
                var _countdownInterval = setInterval(updateDisplay, 1000);
                document.addEventListener('visibilitychange', function() {
                  if (document.hidden) {
                    clearInterval(_countdownInterval);
                    _countdownInterval = null;
                  } else {
                    updateDisplay(); // Immediate update on return
                    if (!_countdownInterval) _countdownInterval = setInterval(updateDisplay, 1000);
                  }
                });
              })();
            </script>

          {%- when 'accordion' -%}
            {%- liquid
              assign accordion_title = block.settings.title | default: block.settings.page.title
              assign accordion_content = block.settings.page.content | default: block.settings.liquid | default: block.settings.content

              if accordion_title != blank and accordion_content != blank
                render 'accordion', title: accordion_title, content: accordion_content, prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, block: block, open: block.settings.open
              endif
            -%}
      {% when 'size_guide' %}

   {% comment %} Checks if the metafield is a true boolean OR the typed text "True" {% endcomment %}
   {% if product.metafields.custom.size_gudie == true or product.metafields.custom.size_gudie == 'True' %}

     {% assign fit_value = product.metafields.custom.fit_value | default: 3 | plus: 0 %}

      <div class="fit-guide-wrap" role="region" aria-label="{{ block.settings.main_title }}">
        <div class="fit-guide" role="group" aria-labelledby="fitguide-title">
          <div>
            <div id="fitguide-title" class="fit-guide__title">{{ block.settings.main_title }}</div>
          </div>
          <div class="fit-guide__link js-open-size-guide" title="View size guide">
